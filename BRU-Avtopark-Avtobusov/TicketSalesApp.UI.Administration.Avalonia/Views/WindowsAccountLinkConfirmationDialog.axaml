<PleasantWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="420"
        xmlns:vm="using:TicketSalesApp.UI.Administration.Avalonia.ViewModels"
        x:Class="TicketSalesApp.UI.Administration.Avalonia.Views.WindowsAccountLinkConfirmationDialog"
        x:DataType="vm:WindowsAccountLinkConfirmationViewModel"
        
       xmlns:icons="using:Material.Icons.Avalonia"
        Title=""
        CaptionButtons="Close"
        Width="520" Height="420"
        SystemDecorations="None"
        WindowStartupLocation="CenterOwner"
        EnableTitleBarMargin="False"
        MinWidth="500" MinHeight="400"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        
        Padding="1">

    <Design.DataContext>
        <vm:WindowsAccountLinkConfirmationViewModel />
    </Design.DataContext>

    <!-- Main window border for rounded corners and background -->
    <Border  Background="Transparent"
            CornerRadius="8"
            ClipToBounds="True">

        <Grid RowDefinitions="Auto,*,Auto">
            
            <!-- Custom Title Bar Area -->
            <!-- The Close button is rendered by CaptionButtons="Close" -->
            <!-- We add a PointerPressed handler to the root Grid to enable dragging -->
            <Grid Grid.Row="0"
                  Height="40"
                  Background="Transparent"
                  >
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                    <icons:MaterialIcon Kind="ShieldCheck"
                                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                        Width="16" Height="16"/>
                    <TextBlock Text="Windows Security"
                               VerticalAlignment="Center"
                               FontSize="12"/>
                </StackPanel>
            </Grid>

            <!-- Main Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" Margin="32,8,32,24">
                    
                    <!-- Header Text -->
                    <TextBlock Text="Do you want to link these accounts?"
                               FontSize="24"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    
                    <!-- Subtitle Text -->
                    <TextBlock Text="Linking will grant your Windows account the same access rights as your application account."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>

                    <!-- Account Linking Info Block -->
                    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                            CornerRadius="4"
                            Padding="16">
						<StackPanel Spacing="16">
							<!-- Windows Account Section -->
							<Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
								<!-- Circular Icon -->
								<Border Grid.Column="0"
                                        Width="32"
                                        Height="32"
                                        CornerRadius="16"
                                        Background="{DynamicResource SystemControlForegroundAccentBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,16,0">
									<icons:MaterialIcon Kind="Check"
                                                      Width="20"
                                                      Height="20"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
								</Border>
								<!-- Account Text -->
								<StackPanel Grid.Column="1" Spacing="2">
									<TextBlock Text="Windows Account" FontWeight="SemiBold" FontSize="14"/>
									<TextBlock Text="{Binding WindowsUsername}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
								</StackPanel>
							</Grid>

							<!-- Application Account Section -->
							<Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
								<!-- This empty column acts as a spacer to align the text with the text above -->
								<Border Grid.Column="0" Width="32" Margin="0,0,16,0" />

								<!-- Account Text -->
								<StackPanel Grid.Column="1" Spacing="2">
									<TextBlock Text="Application Account" FontWeight="SemiBold" FontSize="14"/>
									<TextBlock Text="{Binding Username}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
								</StackPanel>
							</Grid>
						</StackPanel>
                    </Border>
                    
                    <!-- "Show More" toggle for security details -->
                    <ToggleButton Name="ShowMoreToggle"
                                  Theme="{StaticResource HyperlinkToggleButton}"
                                  Content="Show more"
                                  HorizontalAlignment="Left"/>
                    
                    <!-- Collapsible Security Warning -->
                    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource SystemControlBackgroundListLowBrush}"
                            CornerRadius="4"
                            Padding="16"
                            IsVisible="{Binding #ShowMoreToggle.IsChecked}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Security Publisher" FontWeight="SemiBold" />
                                <TextBlock Text="SuperNova Authentication Broker" TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                            
                            <StackPanel Spacing="4">
                                <TextBlock Text="Verification Token" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Text="{Binding Token, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Padding="8,6"
                                             Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                             BorderThickness="1"
                                             BorderBrush="{DynamicResource SystemControlBackgroundListMediumBrush}"
                                             FontFamily="Consolas, Courier New, monospace"/>
                                    <Button Grid.Column="1"
                                            Command="{Binding CopyTokenCommand}"
                                            Margin="8,0,0,0"
                                            MinWidth="80"
                                            Content="Copy"
                                            Theme="{StaticResource DefaultButtonStyle}"
                                            Padding="12,0"/>
                                </Grid>
                                <TextBlock Text="Please provide this token to the application to complete the linking process." 
                                           TextWrapping="Wrap" 
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           FontSize="12"/>
                            </StackPanel>
                            
                            <TextBlock Text="This action is managed by the application's security provider. If you do not recognize this request, cancel the operation and contact your administrator." 
                                       TextWrapping="Wrap" 
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer Button Bar -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Margin="24">
                    
                    <Button Content="Link accounts"
                            Command="{Binding ConfirmCommand}"
                            MinWidth="120"
                            Theme="{StaticResource AccentButtonStyle}"/>

                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            MinWidth="120"
                            Theme="{StaticResource DefaultButtonStyle}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</PleasantWindow>