<PleasantWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:icons="using:Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="640"
        x:Class="SuperNova.Forms.Views.AboutWindow"
        Title=""
        
        Width="480" Height="640"
        MinWidth="480" MinHeight="600"
        
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        CaptionButtons="Close"
       
        Padding="1">

	<PleasantWindow.Styles>
		<!-- Style for TreeViewItems to make them look like modern expandable sections -->
		<Style Selector="TreeViewItem">
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
			<Setter Property="Padding" Value="0,8"/>
			
		</Style>

		

		<!-- Style for informational text blocks within the tree -->
		<Style Selector="TextBlock.info">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
			<Setter Property="Margin" Value="24, 4, 0, 4"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>

		<!-- Style to hide the default expander toggle -->
		<Style Selector="TreeViewItem > ToggleButton">
			<Setter Property="IsVisible" Value="False"/>
		</Style>

	</PleasantWindow.Styles>

	<Border Background="Transparent"
            CornerRadius="8"
            ClipToBounds="True">

		<Grid RowDefinitions="Auto,*,Auto">

			<!-- Custom Title Bar Area (for aesthetics and dragging) -->
			<Border Grid.Row="0" Height="40" Background="Transparent" IsHitTestVisible="True"/>

			<!-- Main Content Area -->
			<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="0,0,0,24">
				<StackPanel Spacing="16" Margin="48,0,48,0">

					<!-- Header Section -->
					<StackPanel Spacing="12" HorizontalAlignment="Center" TextBlock.TextAlignment="Center" Margin="0,0,0,24">
						<icons:MaterialIcon Kind="InfoOutline" Width="48" Height="48" Foreground="{DynamicResource SystemControlForegroundAccentBrush}"/>
						<TextBlock Text="Автопарк автобусов" FontSize="28" FontWeight="SemiBold"/>
						<TextBlock Text="Система управления автобусным парком" FontSize="14" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap" MaxWidth="300"/>
						<TextBlock Text="Версия 0.5A" FontSize="13" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
					</StackPanel>

					<!-- TreeView for categorized information -->
					<TreeView Name="InfoTreeView" Background="Transparent">
						<TreeViewItem Header="Информация о продукте" IsExpanded="True">
							<StackPanel Spacing="2">
								<TextBlock Text="Разработано в рамках курсового проекта" Classes="info"/>
								<TextBlock Text="Группа: АСОИСЗ-241" Classes="info"/>
								<TextBlock Text="ФИО: Савич Андрей Олегович" Classes="info"/>
								<TextBlock Text="Год: 2025" Classes="info"/>
							</StackPanel>
						</TreeViewItem>

						<TreeViewItem Header="Используемые технологии" IsExpanded="True">
							<ItemsControl Name="TechnologyList" Margin="24, 4, 0, 4">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   Margin="0,2"/>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</TreeViewItem>

						<TreeViewItem Header="Системная информация" IsExpanded="True">
							<StackPanel Spacing="2">
								<TextBlock Name="RuntimeVersion" Classes="info"/>
								<TextBlock Name="OsVersion" Classes="info"/>
								<TextBlock Name="AvaloniaVersion" Classes="info"/>
							</StackPanel>
						</TreeViewItem>
					</TreeView>
				</StackPanel>
			</ScrollViewer>

			<!-- Footer Button Bar -->
			<Border Grid.Row="2"
                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                    BorderBrush="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}"
                    BorderThickness="0,1,0,0"
                    Height="80">
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Center" Margin="24,0">
					<Button Content="Копировать информацию"
                            Click="OnCopyInfo"
                            MinWidth="120"
                            Theme="{StaticResource DefaultButtonStyle}"/>
					<Button Content="Закрыть"
                            Click="OnClose"
                            MinWidth="120"
                            Theme="{StaticResource AccentButtonStyle}"/>
				</StackPanel>
			</Border>
		</Grid>
	</Border>
</PleasantWindow>