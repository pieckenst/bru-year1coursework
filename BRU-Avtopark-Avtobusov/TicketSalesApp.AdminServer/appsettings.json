{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=TicketSalesDb;Trusted_Connection=True;MultipleActiveResultSets=true",
    "Redis": "localhost:6379,password=devpassword",
    "MongoDB": "mongodb://ticketsales_dev:devpassword@localhost:27017/ticketsales",
    "Elasticsearch": "http://localhost:9200"
  },
  "DatabaseProvider": "SQLite",
  "JwtSettings": {
    "Secret": "YourSuperSecretKeyWith32BytesOrMore123!@#",
    "ExpirationInMinutes": 120,
    "Issuer": "TicketSalesApp",
    "Audience": "TicketSalesApp.Admin"
  },
  "WindowsAuthentication": {
    "Enabled": true,
    "AutoProvisionUsers": true,
    "DefaultRole": 0,
    "AllowedDomains": []
  },
  "Redis": {
    "ConnectionString": "localhost:6379,password=devpassword",
    "InstanceName": "TicketSalesApp",
    "DefaultDatabase": 0,
    "CacheDatabase": 1,
    "SessionDatabase": 2,
    "SignalRDatabase": 3
  },
  "MongoDB": {
    "ConnectionString": "mongodb://ticketsales_dev:devpassword@localhost:27017/ticketsales",
    "DatabaseName": "ticketsales",
    "Collections": {
      "Logs": "logs",
      "Analytics": "analytics",
      "Exports": "exports",
      "Notifications": "notifications"
    }
  },
  "Hangfire": {
    "ConnectionString": "Server=(localdb)\\mssqllocaldb;Database=TicketSalesDb_Hangfire;Trusted_Connection=True;MultipleActiveResultSets=true",
    "DashboardPath": "/hangfire",
    "WorkerCount": 5,
    "Queues": ["default", "exports", "notifications", "maintenance"]
  },
  "SignalR": {
    "UseRedisBackplane": false,
    "RedisConnectionString": "localhost:6379,password=devpassword",
    "HubPath": "/hubs/notifications",
    "EnableDetailedErrors": true,
    "ClientTimeoutInterval": "00:01:00",
    "KeepAliveInterval": "00:00:15"
  },
  "WebAuthn": {
    "ServerDomain": "localhost",
    "ServerName": "TicketSales Admin Server",
    "Origins": ["https://localhost:5001", "http://localhost:5000"],
    "TimestampDriftTolerance": 300000,
    "ChallengeSize": 32
  },
  "TwoFactorAuth": {
    "Issuer": "TicketSales",
    "QRCodeSize": 200,
    "RecoveryCodesCount": 10,
    "TimeStepTolerance": 1
  },
  "OpenTelemetry": {
    "ServiceName": "TicketSales.AdminServer",
    "ServiceVersion": "1.0.0",
    "Jaeger": {
      "AgentHost": "localhost",
      "AgentPort": 6831,
      "Endpoint": "http://localhost:14268/api/traces"
    },
    "Console": {
      "Enabled": true
    },
    "Sampling": {
      "Ratio": 1.0
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Elasticsearch",
      "Serilog.Enrichers.CorrelationId",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Process",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Authentication": "Information",
        "Microsoft.AspNetCore.SignalR": "Information",
        "Hangfire": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ticketsales-admin-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {CorrelationId} {SourceContext} {UserId} {RequestPath}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodeUris": "http://localhost:9200",
          "indexFormat": "ticketsales-logs-{0:yyyy.MM.dd}",
          "autoRegisterTemplate": true,
          "numberOfShards": 2,
          "numberOfReplicas": 1
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithCorrelationId",
      "WithEnvironmentName",
      "WithProcessId",
      "WithProcessName",
      "WithThreadId",
      "WithMachineName"
    ],
    "Properties": {
      "Application": "TicketSales.AdminServer",
      "Environment": "Development"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore.Authentication": "Information"
    }
  },
  "Caching": {
    "DefaultExpiration": "00:15:00",
    "SlidingExpiration": "00:05:00",
    "Policies": {
      "Users": "00:30:00",
      "Buses": "01:00:00",
      "Routes": "01:00:00",
      "Roles": "02:00:00"
    }
  },
  "RateLimiting": {
    "GlobalLimit": 1000,
    "PerUserLimit": 100,
    "WindowSizeInMinutes": 1,
    "Endpoints": {
      "/api/auth/login": 10,
      "/api/auth/register": 5,
      "/api/export/*": 3
    }
  },
  "Security": {
    "RequireHttps": true,
    "HstsMaxAge": 31536000,
    "AccountLockout": {
      "MaxFailedAttempts": 5,
      "LockoutDuration": "00:15:00"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      },
      "Https": {
        "Url": "https://0.0.0.0:5001"
      }
    },
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    }
  },
  "QRLogin": {
    "EncryptionKey": "qr-login-encryption-key-32-bytes-123",
    "SessionTimeoutMinutes": 5
  },
  "ForwardedHeaders": {
    "ForwardedHeaders": "All"
  },
  "Export": {
    "ExportDirectory": "exports",
    "FileExpirationHours": 24,
    "MaxFileSizeBytes": 104857600,
    "DefaultBatchSize": 1000,
    "MaxConcurrentJobs": 5,
    "BaseDownloadUrl": null
  }
}
