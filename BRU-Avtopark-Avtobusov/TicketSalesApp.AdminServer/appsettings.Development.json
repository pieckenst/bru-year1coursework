{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=ticketsales.db",
    "Redis": "localhost:6379,password=devpassword",
    "MongoDB": "mongodb://ticketsales_dev:devpassword@localhost:27017/ticketsales",
    "Elasticsearch": "http://localhost:9200"
  },
  "DatabaseProvider": "SQLite",
  "Redis": {
    "ConnectionString": "localhost:6379,password=devpassword"
  },
  "MongoDB": {
    "ConnectionString": "mongodb://ticketsales_dev:devpassword@localhost:27017/ticketsales"
  },
  "Hangfire": {
    "ConnectionString": "Data Source=ticketsales_hangfire.db"
  },
  "OpenTelemetry": {
    "Jaeger": {
      "AgentHost": "localhost",
      "AgentPort": 6831,
      "Endpoint": "http://localhost:14268/api/traces"
    },
    "Console": {
      "Enabled": true
    },
    "Sampling": {
      "Ratio": 1.0
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Authentication": "Debug",
        "Microsoft.AspNetCore.SignalR": "Debug",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ticketsales-admin-dev-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {CorrelationId} {SourceContext} {UserId} {RequestPath}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodeUris": "http://localhost:9200",
          "indexFormat": "ticketsales-dev-logs-{0:yyyy.MM.dd}",
          "autoRegisterTemplate": true
        }
      }
    ],
    "Properties": {
      "Environment": "Development"
    }
  },
  "SignalR": {
    "EnableDetailedErrors": true
  },
  "Security": {
    "RequireHttps": false
  },
  "RateLimiting": {
    "GlobalLimit": 10000,
    "PerUserLimit": 1000
  }
}