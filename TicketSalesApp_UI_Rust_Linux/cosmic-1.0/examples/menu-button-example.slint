import { CosmicTextInput } from "../ui/components/text-input.slint";
import { CosmicTextArea } from "../ui/components/text-area.slint";
import { CosmicSearchInput, SearchSuggestion } from "../ui/components/search-input.slint";
import { CosmicPalette } from "../ui/styling/palette.slint";
import { CosmicSpacing } from "../ui/styling/spacing.slint";
import { CosmicMenuButton, CosmicMenuBarItem, MenuItemType, MenuItem } from "../ui/components/menu-button.slint";
import { ButtonClass, ButtonSize } from "../ui/components/button.slint";

export component MenuButtonExample inherits Window {
    title: "COSMIC Menu Button Example";
    background: CosmicPalette.background-base;
    
    preferred-width: 800px;
    preferred-height: 600px;
    
    VerticalLayout {
        padding: 24px;
        spacing: 24px;
        
        Text {
            text: "Menu Button Examples";
            font-size: 24px;
            font-weight: 700;
            color: CosmicPalette.text-primary;
        }
        
        // Example 1: Simple menu button (standard)
        HorizontalLayout {
            spacing: 16px;
            
            Text {
                text: "Standard Menu:";
                color: CosmicPalette.text-primary;
                vertical-alignment: center;
            }
            
            CosmicMenuButton {
                text: "File";
                menu-items: [
                    {
                        id: "new",
                        label: "New",
                        icon: @image-url(""),
                        shortcut: "Ctrl+N",
                        item-type: MenuItemType.standard,
                        checked: false,
                        enabled: true,
                        has-submenu: false,
                    },
                    {
                        id: "open",
                        label: "Open",
                        icon: @image-url(""),
                        shortcut: "Ctrl+O",
                        item-type: MenuItemType.standard,
                        checked: false,
                        enabled: true,
                        has-submenu: false,
                    },
                    {
                        id: "sep1",
                        label: "",
                        icon: @image-url(""),
                        shortcut: "",
                        item-type: MenuItemType.divider,
                        checked: false,
                        enabled: true,
                        has-submenu: false,
                    },
                    {
                        id: "save",
                        label: "Save",
                        icon: @image-url(""),
                        shortcut: "Ctrl+S",
                        item-type: MenuItemType.standard,
                        checked: false,
                        enabled: true,
                        has-submenu: false,
                    },
                    {
                        id: "save-as",
                        label: "Save As...",
                        icon: @image-url(""),
                        shortcut: "Ctrl+Shift+S",
                        item-type: MenuItemType.standard,
                        checked: false,
                        enabled: true,
                        has-submenu: false,
                    },
                    {
                        id: "sep2",
                        label: "",
                        icon: @image-url(""),
                        shortcut: "",
                        item-type: MenuItemType.divider,
                        checked: false,
                        enabled: true,
                        has-submenu: false,
                    },
                    {
                        id: "exit",
                        label: "Exit",
                        icon: @image-url(""),
                        shortcut: "Ctrl+Q",
                        item-type: MenuItemType.danger,
                        checked: false,
                        enabled: true,
                        has-submenu: false,
                    },
                ];
                
                menu-item-clicked(id) => {
                    debug("Menu item clicked ID:", id);
                }
            }
        }
        
        // Example 2: Menu with checkboxes
        HorizontalLayout {
            spacing: 16px;
            
            Text {
