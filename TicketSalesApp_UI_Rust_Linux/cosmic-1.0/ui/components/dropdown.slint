import { CosmicPalette } from "../styling/palette.slint";
import { CosmicTypography } from "../styling/typography.slint";
import { CosmicSpacing } from "../styling/spacing.slint";
import { CosmicCornerRadii } from "../styling/corner-radii.slint";
import { CosmicElevation } from "../styling/elevation.slint";

// Dropdown option structure
export struct DropdownOption {
    text: string,
    value: string,
    icon: image,
    disabled: bool,
    group: string,
}

// CosmicDropdown - Dropdown/Select component with search and multi-select support
// Requirements: 60.1-60.10
export component CosmicDropdown {
    // Content properties
    in property <string> label;
    in property <string> placeholder: "Select...";
    in property <[DropdownOption]> options;
    
    // Selection properties
    in-out property <string> selected-value;
    in-out property <[string]> selected-values; // For multi-select
    in property <bool> multi-select: false;
    
    // State properties (Requirement 60.8)
    in property <bool> disabled: false;
    
    // Search properties (Requirement 60.5)
    in property <bool> searchable: false;
    in-out property <string> search-text;
    
    // Display properties
    in property <length> dropdown-width: 200px;
    in property <length> max-dropdown-height: 36px * 8; // Max 8 visible items (Requirement 60.2)
    
    // Callbacks
    callback option-selected(string /* value */);
    callback options-changed([string] /* values */);
    
    // Internal state
    property <bool> is-open: false;
    property <bool> is-focused: false;
    property <int> hovered-index: -1;
    
    // Computed properties
    property <string> display-text: {
        if root.multi-select {
            if root.selected-values.length == 0 {
                root.placeholder
            } else if root.selected-values.length == 1 {
                // Find the text for the first selected value
                root.placeholder // Simplified - would need to look up text
            } else {
                root.selected-values.length + " selected"
            }
        } else {
            if root.selected-value == "" {
                root.placeholder
            } else {
                // Find the text for the selected value
                root.selected-value // Simplified - would show value instead of text
            }
        }
    };
    
    // Filtered options based on search
    property <[DropdownOption]> filtered-options: root.options;
    
    min-width: root.dropdown-width;
    
    VerticalLayout {
        spacing: CosmicSpacing.space-xxxs;
        
        // Label
        if root.label != "": Text {
            text: root.label;
            color: CosmicPalette.text-primary;
            font-family: CosmicTypography.font-family;
            font-size: CosmicTypography.label-size;
            font-weight: CosmicTypography.label-weight;
        }
        
        // Dropdown trigger (Requirement 60.1)
        trigger := Rectangle {
            height: 32px;
            background: CosmicPalette.background-surface;
            border-radius: CosmicCornerRadii.input-radius;
            border-width: root.is-focused || root.is-open ? 2px : 1px;
            border-color: root.is-focused || root.is-open ? 
                CosmicPalette.accent-primary : 
                CosmicPalette.border-neutral;
            
            states [
                disabled when root.disabled: {
                    opacity: 0.5; // Requirement 60.8
                }
            ]
            
            HorizontalLayout {
                padding-left: CosmicSpacing.input-padding-horizontal;
                padding-right: CosmicSpacing.input-padding-horizontal;
                spacing: CosmicSpacing.space-xxs;
                
                // Display text
                Text {
                    text: root.display-text;
                    color: (root.selected-value == "" && !root.multi-select) || (root.selected-values.length == 0 && root.multi-select) ? CosmicPalette.text-secondary : CosmicPalette.text-primary;
                    font-family: CosmicTypography.font-family;
                    font-size: CosmicTypography.input-size;
                    font-weight: CosmicTypography.input-weight;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                
                // Down arrow icon (Requirement 60.1)
                Rectangle {
                    width: 16px;
                    height: 16px;
                    
                    // Simple down arrow using Path
                    Path {
                        width: 12px;
                        height: 12px;
                        x: 2px;
                        y: 2px;
                        
                        commands: "M 2 4 L 6 8 L 10 4";
                        stroke: CosmicPalette.text-secondary;
                        stroke-width: 2px;
                        
                        // Note: Rotation animation would require custom implementation
                    }
                }
            }
            
            trigger-touch := TouchArea {
                mouse-cursor: root.disabled ? MouseCursor.default : MouseCursor.pointer;
                
                clicked => {
                    if !root.disabled {
                        root.is-open = !root.is-open;
                        if root.is-open {
                            root.is-focused = true;
                        }
                    }
                }
            }
        }
        
        // Dropdown menu (Requirements 60.2-60.10)
        if root.is-open: Rectangle {
            background: CosmicPalette.background-surface;
            border-radius: CosmicCornerRadii.input-radius;
            border-width: 1px;
            border-color: CosmicPalette.border-neutral;
            drop-shadow-offset-y: CosmicElevation.shadow-md-offset-y;
            drop-shadow-blur: CosmicElevation.shadow-md-blur;
            drop-shadow-color: CosmicPalette.shadow-color-md;
            
            // Max height for dropdown (Requirement 60.2, 60.9)
            max-height: root.max-dropdown-height;
            
            VerticalLayout {
                padding: CosmicSpacing.space-xxxs;
                spacing: 0px;
                
                // Search input at top (Requirement 60.5)
                if root.searchable: Rectangle {
                    height: 32px;
                    
                    HorizontalLayout {
                        padding-left: CosmicSpacing.space-xs;
                        padding-right: CosmicSpacing.space-xs;
                        padding-top: CosmicSpacing.space-xxxs;
                        padding-bottom: CosmicSpacing.space-xxxs;
                        
                        Rectangle {
                            background: CosmicPalette.surface-variant;
                            border-radius: CosmicCornerRadii.radius-xs;
                            
                            HorizontalLayout {
                                padding-left: CosmicSpacing.space-xxs;
                                padding-right: CosmicSpacing.space-xxs;
                                spacing: CosmicSpacing.space-xxs;
                                
                                // Search icon
                                Text {
                                    text: "🔍";
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                                
                                search-input := TextInput {
                                    text <=> root.search-text;
                                    color: CosmicPalette.text-primary;
                                    font-family: CosmicTypography.font-family;
                                    font-size: CosmicTypography.body-size;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                }
                
                // Options list with scrolling (Requirement 60.9)
                Flickable {
                    viewport-height: options-layout.preferred-height;
                    
                    options-layout := VerticalLayout {
                        spacing: 0px;
                        
                        // Render options grouped if they have groups (Requirement 60.7)
                        for option[index] in root.filtered-options: VerticalLayout {
                            spacing: 0px;
                            
                            // Group header (Requirement 60.7)
                            if option.group != "" && (index == 0 || root.filtered-options[index - 1].group != option.group): Rectangle {
                                height: 28px;
                                
                                HorizontalLayout {
                                    padding-left: CosmicSpacing.space-xs;
                                    padding-right: CosmicSpacing.space-xs;
                                    
                                    Text {
                                        text: option.group;
                                        color: CosmicPalette.text-secondary;
                                        font-family: CosmicTypography.font-family;
                                        font-size: CosmicTypography.caption-size;
                                        font-weight: CosmicTypography.weight-semibold;
                                        vertical-alignment: center;
                                    }
                                }
                                
                                // Divider below group header
                                Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px;
                                    background: CosmicPalette.divider;
                                }
                            }
                            
                            // Option item (Requirements 60.3, 60.4, 60.6, 60.10)
                            option-item := Rectangle {
                                height: 36px;
                                border-radius: CosmicCornerRadii.radius-xs;
                                
                                // Check if this option is selected
                                property <bool> is-option-selected: {
                                    if root.multi-select {
                                        // Check if value is in selected-values array
                                        false // Simplified - would need proper array search
                                    } else {
                                        root.selected-value == option.value
                                    }
                                };
                                
                                background: {
                                    if option.disabled {
                                        Colors.transparent
                                    } else if is-option-selected {
                                        CosmicPalette.accent-primary.with-alpha(0.15) // Requirement 60.4
                                    } else if option-touch.has-hover || index == root.hovered-index {
                                        CosmicPalette.surface-variant.with-alpha(0.5) // Requirement 60.3
                                    } else {
                                        Colors.transparent
                                    }
                                };
                                
                                states [
                                    disabled when option.disabled: {
                                        opacity: 0.5;
                                    }
                                ]
                                
                                HorizontalLayout {
                                    padding-left: CosmicSpacing.space-xs;
                                    padding-right: CosmicSpacing.space-xs;
                                    spacing: CosmicSpacing.space-xxs;
                                    
                                    // Checkbox for multi-select (Requirement 60.6)
                                    if root.multi-select: Rectangle {
                                        width: 20px;
                                        height: 20px;
                                        border-radius: CosmicCornerRadii.checkbox-radius;
                                        border-width: 2px;
                                        border-color: is-option-selected ? 
                                            CosmicPalette.accent-primary : 
                                            CosmicPalette.border-neutral;
                                        background: is-option-selected ? 
                                            CosmicPalette.accent-primary : 
                                            Colors.transparent;
                                        
                                        // Checkmark
                                        if is-option-selected: Path {
                                            width: 12px;
                                            height: 12px;
                                            x: 4px;
                                            y: 4px;
                                            
                                            commands: "M 2 6 L 5 9 L 10 2";
                                            stroke: Colors.white;
                                            stroke-width: 2px;
                                        }
                                    }
                                    
                                    // Icon before text (Requirement 60.10)
                                    if option.icon.width > 0: Image {
                                        source: option.icon;
                                        width: 16px;
                                        height: 16px;
                                        colorize: CosmicPalette.text-primary;
                                        vertical-alignment: center;
                                    }
                                    
                                    // Option text
                                    Text {
                                        text: option.text;
                                        color: CosmicPalette.text-primary;
                                        font-family: CosmicTypography.font-family;
                                        font-size: CosmicTypography.body-size;
                                        font-weight: CosmicTypography.weight-regular;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    
                                    // Checkmark for single-select (Requirement 60.4)
                                    if !root.multi-select && is-option-selected: Path {
                                        width: 16px;
                                        height: 16px;
                                        
                                        commands: "M 3 8 L 6 11 L 13 3";
                                        stroke: CosmicPalette.accent-primary;
                                        stroke-width: 2px;
                                    }
                                }
                                
                                option-touch := TouchArea {
                                    mouse-cursor: option.disabled ? 
                                        MouseCursor.default : 
                                        MouseCursor.pointer;
                                    
                                    clicked => {
                                        if !option.disabled {
                                            if root.multi-select {
                                                // In multi-select mode, toggle selection
                                                root.options-changed(root.selected-values);
                                            } else {
                                                // In single-select mode, set value and close
                                                root.selected-value = option.value;
                                                root.option-selected(option.value);
                                                root.is-open = false;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    
    // Close dropdown when clicking outside
    if root.is-open: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        
        TouchArea {
            clicked => {
                root.is-open = false;
                root.is-focused = false;
            }
        }
    }
}
