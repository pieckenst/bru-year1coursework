// COSMIC Desktop Color Palette
// Comprehensive color system with light/dark mode support and semantic naming

export global CosmicPalette {
    // ============================================================================
    // MODE SELECTION
    // ============================================================================
    in-out property <bool> dark-mode: false;
    
    // ============================================================================
    // LIGHT MODE COLORS (Requirements 1.1, 13.1-13.5)
    // ============================================================================
    
    // Light mode backgrounds
    in-out property <color> light-background-base: #F5F5F5;
   in-out property <color> light-background-surface: #FFFFFF;
   in-out property <color> light-background-overlay: #FAFAFA;
   in-out property <color> light-surface-variant: #E8E8E8;
    
    // Light mode text
   in-out property <color> light-text-primary: #1A1A1A;
   in-out property <color> light-text-secondary: #666666;
   in-out property <color> light-text-disabled: #999999;
    
    // Light mode borders and dividers
   in-out property <color> light-border-neutral: #D0D0D0;
   in-out property <color> light-divider: #E0E0E0;
    
    // ============================================================================
    // DARK MODE COLORS (Requirements 1.2, 14.1-14.5)
    // ============================================================================
    
    // Dark mode backgrounds
   in-out property <color> dark-background-base: #1A1A1A;
   in-out property <color> dark-background-surface: #2B2B2B;
   in-out property <color> dark-background-overlay: #333333;
  in-out  property <color> dark-surface-variant: #242424;
    
    // Dark mode text
   in-out property <color> dark-text-primary: #F5F5F5;
   in-out property <color> dark-text-secondary: #AAAAAA;
  in-out  property <color> dark-text-disabled: #666666;
    
    // Dark mode borders and dividers
   in-out property <color> dark-border-neutral: #404040;
  in-out  property <color> dark-divider: #383838;
    
    // ============================================================================
    // ACCENT COLORS (Requirements 1.3, 2.1-2.5)
    // ============================================================================
    
    // Primary accent color (brownish default, can be changed to orange)
    in-out property <color> accent-primary: #8B7355;
    in-out property <color> accent-secondary: #A68968;
    in-out property <color> accent-tertiary: #C4A582;
    
    // Accent color variations for interactions (Requirements 2.3)
  in-out  property <color> accent-hover: #9D8366;
  in-out  property <color> accent-pressed: #79634A;
  in-out  property <color> accent-light: #D4C4B0;
    
    // Alternative accent (orange) - can be swapped with primary
  in-out  property <color> accent-orange: #FF6B35;
  in-out  property <color> accent-orange-hover: #FF7D4D;
   in-out property <color> accent-orange-pressed: #E65A2E;
    
    // ============================================================================
    // SEMANTIC COLORS (Requirements 1.4, 39.4)
    // ============================================================================
    
   in-out property <color> success: #27AE60;
  in-out  property <color> success-light: #2ECC71;
  in-out  property <color> success-dark: #229954;
    
  in-out  property <color> warning: #F39C12;
   in-out property <color> warning-light: #F1C40F;
  in-out  property <color> warning-dark: #D68910;
    
  in-out  property <color> error: #E74C3C;
   in-out property <color> error-light: #EC7063;
  in-out  property <color> error-dark: #C0392B;
    
  in-out  property <color> info: #3498DB;
  in-out  property <color> info-light: #5DADE2;
  in-out  property <color> info-dark: #2874A6;
    
    // ============================================================================
    // COMPUTED COLORS - MODE-AWARE (Requirements 39.1-39.7)
    // ============================================================================
    
    // Background colors (Requirement 39.3)
    out property <color> background-base: dark-mode ? dark-background-base : light-background-base;
    out property <color> background-surface: dark-mode ? dark-background-surface : light-background-surface;
    out property <color> background-overlay: dark-mode ? dark-background-overlay : light-background-overlay;
    out property <color> surface-variant: dark-mode ? dark-surface-variant : light-surface-variant;
    
    // Text colors (Requirement 39.2)
    out property <color> text-primary: dark-mode ? dark-text-primary : light-text-primary;
    out property <color> text-secondary: dark-mode ? dark-text-secondary : light-text-secondary;
    out property <color> text-disabled: dark-mode ? dark-text-disabled : light-text-disabled;
    
    // Border colors (Requirement 39.6)
    out property <color> border-neutral: dark-mode ? dark-border-neutral : light-border-neutral;
    out property <color> border-accent: accent-primary;
    out property <color> border-error: error;
    
    // Divider colors
    out property <color> divider: dark-mode ? dark-divider : light-divider;
    
    // ============================================================================
    // COMPONENT COLORS (Requirement 39.5)
    // ============================================================================
    
    // Component base colors
    out property <color> component-base: background-surface;
    out property <color> component-hover: dark-mode ? 
        dark-background-surface.darker(0.05) : 
        light-background-surface.darker(0.03);
    out property <color> component-pressed: dark-mode ? 
        dark-background-surface.darker(0.1) : 
        light-background-surface.darker(0.05);
    
    // ============================================================================
    // LAYER COLORS (for cards and containers)
    // ============================================================================
    
    // Primary layer (elevated surfaces)
    out property <color> primary-base: background-surface;
    out property <color> primary-hover: component-hover;
    out property <color> primary-pressed: component-pressed;
    
    // Secondary layer (further elevated)
    out property <color> secondary-base: dark-mode ? 
        #333333 : 
        light-background-surface;
    out property <color> secondary-hover: dark-mode ? 
        #383838 : 
        light-background-surface.darker(0.02);
    out property <color> secondary-pressed: dark-mode ? 
        #2E2E2E : 
        light-background-surface.darker(0.04);
    
    // ============================================================================
    // OPACITY HELPERS
    // ============================================================================
    
    // Standard opacity values for consistent transparency
    out property <float> opacity-disabled: 0.4;
    out property <float> opacity-hover: 0.08;
    out property <float> opacity-pressed: 0.15;
    out property <float> opacity-selected: 0.15;
    out property <float> opacity-backdrop: 0.5;
    
    // ============================================================================
    // SHADOW COLORS (Requirements 5.1-5.5)
    // ============================================================================
    
    // Shadow colors adjusted for light/dark modes
    out property <color> shadow-color-sm: dark-mode ? #00000033 : #00000019;  // 20% / 10%
    out property <color> shadow-color-md: dark-mode ? #00000040 : #00000026;  // 25% / 15%
    out property <color> shadow-color-lg: dark-mode ? #0000004D : #00000033;  // 30% / 20%
}
