import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";
import { MaterialPalette } from "../material-1.0/ui/styling/material_palette.slint";
import { FilledCard, TextField, FilledButton, TonalButton, HorizontalDivider, MaterialText } from "../material-1.0/material.slint";

export struct MonthlyIncomeData {
    month: string,
    year: int,
    total_income: float,
    tickets_sold: int,
    average_ticket_price: float,
}

export struct RouteIncomeData {
    route_name: string,
    total_income: float,
    tickets_sold: int,
    average_ticket_price: float,
}

export struct RouteStatisticData {
    route_name: string,
    total_sales: int,
    total_revenue: float,
    sales_percentage: float,
}

export struct DailyStatisticData {
    date: string,
    total_sales: int,
    total_revenue: float,
    growth_rate: float,
}

export component ReportsView inherits Rectangle {
    // Tab state
    in-out property <int> active_tab: 0; // 0 = Income Report, 1 = Sales Statistics

    // Income Report data
    in-out property <[MonthlyIncomeData]> monthly_incomes: [];
    in-out property <[RouteIncomeData]> route_incomes: [];
    in-out property <float> total_income: 0.0;
    in-out property <int> total_tickets_sold: 0;
    in-out property <float> average_ticket_price: 0.0;

    // Sales Statistics data
    in-out property <[RouteStatisticData]> route_statistics: [];
    in-out property <[DailyStatisticData]> daily_statistics: [];
    in-out property <int> total_sales: 0;
    in-out property <float> total_revenue: 0.0;
    in-out property <float> average_growth_rate: 0.0;

    // Common properties
    in-out property <string> start_date: "";
    in-out property <string> end_date: "";
    in-out property <string> error_message: "";
    in-out property <bool> has_error: false;
    in-out property <bool> is_busy: false;

    callback refresh_income_report();
    callback refresh_sales_statistics();

    background: MaterialPalette.background;

    VerticalBox {
        padding: 20px;
        spacing: 15px;

        // Header with tabs
        VerticalBox {
            spacing: 10px;

            // Title
            Text {
                text: "Отчёты и статистика";
                font-size: 28px;
                font-weight: 700;
                color: MaterialPalette.on-background;
            }

            // Tab buttons
            HorizontalBox {
                spacing: 10px;
                alignment: start;

                Rectangle {
                    width: 200px;
                    height: 40px;
                    background: active_tab == 0 ? MaterialPalette.primary : MaterialPalette.surface-container;
                    border-radius: 20px;

                    TouchArea {
                        clicked => {
                            root.active_tab = 0;
                        }
                    }

                    Text {
                        text: "Отчет по доходам";
                        color: active_tab == 0 ? MaterialPalette.on-primary : MaterialPalette.on-surface;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                Rectangle {
                    width: 200px;
                    height: 40px;
                    background: active_tab == 1 ? MaterialPalette.primary : MaterialPalette.surface-container;
                    border-radius: 20px;

                    TouchArea {
                        clicked => {
                            root.active_tab = 1;
                        }
                    }

                    Text {
                        text: "Статистика продаж";
                        color: active_tab == 1 ? MaterialPalette.on-primary : MaterialPalette.on-surface;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        HorizontalDivider {}

        // Date Range Selector
        HorizontalBox {
            spacing: 10px;
            alignment: start;

            TextField {
                text <=> start_date;
                placeholder-text: "Начальная дата (YYYY-MM-DD)";
                enabled: !is_busy;
                min-width: 200px;
            }

            Text {
                text: "-";
                vertical-alignment: center;
                color: MaterialPalette.on-background;
            }

            TextField {
                text <=> end_date;
                placeholder-text: "Конечная дата (YYYY-MM-DD)";
                enabled: !is_busy;
                min-width: 200px;
            }

            FilledButton {
                text: "Обновить";
                enabled: !is_busy;
                clicked => {
                    if (root.active_tab == 0) {
                        root.refresh_income_report();
                    } else {
                        root.refresh_sales_statistics();
                    }
                }
            }
        }

        // Error message
        if has_error: Rectangle {
            background: #ffebee;
            border-radius: 4px;
            padding: 10px;

            Text {
                text: error_message;
                color: #c62828;
                font-size: 14px;
                wrap: word-wrap;
            }
        }

        // Loading indicator
        if is_busy: HorizontalBox {
            alignment: center;
            Text {
                text: "Загрузка данных...";
                color: MaterialPalette.on-background;
                font-size: 16px;
            }
        }

        // Income Report Content
        if active_tab == 0 && !is_busy: ScrollView {
            vertical-stretch: 1;

            VerticalBox {
                spacing: 20px;

                // Summary Cards for Income
                HorizontalBox {
                    spacing: 15px;

                    FilledCard {
                        horizontal-stretch: 1;
                        VerticalBox {
                            padding: 20px;
                            spacing: 10px;

                            HorizontalBox {
                                spacing: 10px;
                                Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    background: MaterialPalette.primary;
                                    border-radius: 12px;
                                }
                                Text {
                                    text: "Общий доход";
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: MaterialPalette.on-background;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: total_income + " ₽";
                                font-size: 32px;
                                font-weight: 700;
                                color: MaterialPalette.primary;
                            }
                        }
                    }

                    FilledCard {
                        horizontal-stretch: 1;
                        VerticalBox {
                            padding: 20px;
                            spacing: 10px;

                            HorizontalBox {
                                spacing: 10px;
                                Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    background: #1976d2;
                                    border-radius: 12px;
                                }
                                Text {
                                    text: "Продано билетов";
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: MaterialPalette.on-background;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: total_tickets_sold;
                                font-size: 32px;
                                font-weight: 700;
                                color: #1976d2;
                            }
                        }
                    }

                    FilledCard {
                        horizontal-stretch: 1;
                        VerticalBox {
                            padding: 20px;
                            spacing: 10px;

                            HorizontalBox {
                                spacing: 10px;
                                Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    background: #f57c00;
                                    border-radius: 12px;
                                }
                                Text {
                                    text: "Средняя цена";
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: MaterialPalette.on-background;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: average_ticket_price + " ₽";
                                font-size: 32px;
                                font-weight: 700;
                                color: #f57c00;
                            }
                        }
                    }
                }

                // Income Tables
                HorizontalBox {
                    spacing: 15px;

                    // Monthly Income Table
                    FilledCard {
                        horizontal-stretch: 1;
                        VerticalBox {
                            padding: 20px;
                            spacing: 15px;

                            Text {
                                text: "Доход по месяцам";
                                font-size: 18px;
                                font-weight: 600;
                                color: MaterialPalette.on-background;
                            }

                            // Table Header
                            Rectangle {
                                background: MaterialPalette.surface-variant;
                                border-radius: 4px;

                                HorizontalBox {
                                    padding: 10px;
                                    spacing: 10px;

                                    Text { text: "Месяц"; font-weight: 700; width: 100px; color: MaterialPalette.on-background; }
                                    Text { text: "Год"; font-weight: 700; width: 60px; color: MaterialPalette.on-background; }
                                    Text { text: "Доход"; font-weight: 700; width: 100px; color: MaterialPalette.on-background; }
                                    Text { text: "Билетов"; font-weight: 700; width: 70px; color: MaterialPalette.on-background; }
                                    Text { text: "Средняя"; font-weight: 700; horizontal-stretch: 1; color: MaterialPalette.on-background; }
                                }
                            }

                            ScrollView {
                                height: 250px;
                                viewport-height: monthly_incomes.length * 45px;

                                VerticalBox {
                                    spacing: 2px;

                                    for income[index] in monthly_incomes: Rectangle {
                                        height: 40px;
                                        background: mod(index, 2) == 0 ? MaterialPalette.surface : MaterialPalette.background;

                                        HorizontalBox {
                                            padding: 8px;
                                            spacing: 10px;

                                            Text { text: income.month; width: 100px; color: MaterialPalette.on-background; vertical-alignment: center; }
                                            Text { text: income.year; width: 60px; color: MaterialPalette.on-background; vertical-alignment: center; }
                                            Text { text: income.total_income + " ₽"; width: 100px; color: MaterialPalette.on-background; vertical-alignment: center; }
                                            Text { text: income.tickets_sold; width: 70px; color: MaterialPalette.on-background; vertical-alignment: center; }
                                            Text { text: income.average_ticket_price + " ₽"; horizontal-stretch: 1; color: MaterialPalette.on-background; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }

                            if monthly_incomes.length == 0: Text {
                                text: "Нет данных";
                                color: MaterialPalette.on-surface-variant;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    // Route Income Table
                    FilledCard {
                        horizontal-stretch: 1;
                        VerticalBox {
                            padding: 20px;
                            spacing: 15px;

                            Text {
                                text: "Доход по маршрутам";
                                font-size: 18px;
                                font-weight: 600;
                                color: MaterialPalette.on-background;
                            }

                            // Table Header
                            Rectangle {
                                background: MaterialPalette.surface-variant;
                                border-radius: 4px;

                                HorizontalBox {
                                    padding: 10px;
                                    spacing: 10px;

                                    Text { text: "Маршрут"; font-weight: 700; horizontal-stretch: 2; color: MaterialPalette.on-background; }
                                    Text { text: "Доход"; font-weight: 700; width: 100px; color: MaterialPalette.on-background; }
                                    Text { text: "Билетов"; font-weight: 700; width: 70px; color: MaterialPalette.on-background; }
                                    Text { text: "Средняя"; font-weight: 700; horizontal-stretch: 1; color: MaterialPalette.on-background; }
                                }
                            }

                            ScrollView {
                                height: 250px;
                                viewport-height: route_incomes.length * 45px;

                                VerticalBox {
                                    spacing: 2px;

                                    for income[index] in route_incomes: Rectangle {
                                        height: 40px;
                                        background: mod(index, 2) == 0 ? MaterialPalette.surface : MaterialPalette.background;

                                        HorizontalBox {
                                            padding: 8px;
                                            spacing: 10px;

                                            Text { text: income.route_name; horizontal-stretch: 2; color: MaterialPalette.on-background; vertical-alignment: center; overflow: elide; }
                                            Text { text: income.total_income + " ₽"; width: 100px; color: MaterialPalette.on-background; vertical-alignment: center; }
                                            Text { text: income.tickets_sold; width: 70px; color: MaterialPalette.on-background; vertical-alignment: center; }
                                            Text { text: income.average_ticket_price + " ₽"; horizontal-stretch: 1; color: MaterialPalette.on-background; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }

                            if route_incomes.length == 0: Text {
                                text: "Нет данных";
                                color: MaterialPalette.on-surface-variant;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Sales Statistics Content
        if active_tab == 1 && !is_busy: ScrollView {
            vertical-stretch: 1;

            VerticalBox {
                spacing: 20px;

                // Summary Cards for Sales
                HorizontalBox {
                    spacing: 15px;

                    FilledCard {
                        horizontal-stretch: 1;
                        VerticalBox {
                            padding: 20px;
                            spacing: 10px;

                            HorizontalBox {
                                spacing: 10px;
                                Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    background: MaterialPalette.primary;
                                    border-radius: 12px;
                                }
                                Text {
                                    text: "Общие продажи";
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: MaterialPalette.on-background;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: total_sales;
                                font-size: 32px;
                                font-weight: 700;
                                color: MaterialPalette.primary;
                            }
                        }
                    }

                    FilledCard {
                        horizontal-stretch: 1;
                        VerticalBox {
                            padding: 20px;
                            spacing: 10px;

                            HorizontalBox {
                                spacing: 10px;
                                Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    background: #2e7d32;
                                    border-radius: 12px;
                                }
                                Text {
                                    text: "Общий доход";
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: MaterialPalette.on-background;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: total_revenue + " ₽";
                                font-size: 32px;
                                font-weight: 700;
                                color: #2e7d32;
                            }
                        }
                    }

                    FilledCard {
                        horizontal-stretch: 1;
                        VerticalBox {
                            padding: 20px;
                            spacing: 10px;

                            HorizontalBox {
                                spacing: 10px;
                                Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    background: #f57c00;
                                    border-radius: 12px;
                                }
                                Text {
                                    text: "Средний рост";
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: MaterialPalette.on-background;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: average_growth_rate + "%";
                                font-size: 32px;
                                font-weight: 700;
                                color: #f57c00;
                            }
                        }
                    }
                }

                // Sales Statistics Tables
                HorizontalBox {
                    spacing: 15px;

                    // Daily Statistics Table
                    FilledCard {
                        horizontal-stretch: 1;
                        VerticalBox {
                            padding: 20px;
                            spacing: 15px;

                            Text {
                                text: "Ежедневная статистика";
                                font-size: 18px;
                                font-weight: 600;
                                color: MaterialPalette.on-background;
                            }

                            // Table Header
                            Rectangle {
                                background: MaterialPalette.surface-variant;
                                border-radius: 4px;

                                HorizontalBox {
                                    padding: 10px;
                                    spacing: 10px;

                                    Text { text: "Дата"; font-weight: 700; width: 120px; color: MaterialPalette.on-background; }
                                    Text { text: "Продажи"; font-weight: 700; width: 80px; color: MaterialPalette.on-background; }
                                    Text { text: "Доход"; font-weight: 700; horizontal-stretch: 1; color: MaterialPalette.on-background; }
                                    Text { text: "Рост"; font-weight: 700; width: 80px; color: MaterialPalette.on-background; }
                                }
                            }

                            ScrollView {
                                height: 250px;
                                viewport-height: daily_statistics.length * 45px;

                                VerticalBox {
                                    spacing: 2px;

                                    for stat[index] in daily_statistics: Rectangle {
                                        height: 40px;
                                        background: mod(index, 2) == 0 ? MaterialPalette.surface : MaterialPalette.background;

                                        HorizontalBox {
                                            padding: 8px;
                                            spacing: 10px;

                                            Text { text: stat.date; width: 120px; color: MaterialPalette.on-background; vertical-alignment: center; }
                                            Text { text: stat.total_sales; width: 80px; color: MaterialPalette.on-background; vertical-alignment: center; }
                                            Text { text: stat.total_revenue + " ₽"; horizontal-stretch: 1; color: MaterialPalette.on-background; vertical-alignment: center; }
                                            Text { text: stat.growth_rate + "%"; width: 80px; color: stat.growth_rate >= 0 ? #2e7d32 : #c62828; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }

                            if daily_statistics.length == 0: Text {
                                text: "Нет данных";
                                color: MaterialPalette.on-surface-variant;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    // Route Statistics Table
                    FilledCard {
                        horizontal-stretch: 1;
                        VerticalBox {
                            padding: 20px;
                            spacing: 15px;

                            Text {
                                text: "Статистика по маршрутам";
                                font-size: 18px;
                                font-weight: 600;
                                color: MaterialPalette.on-background;
                            }

                            // Table Header
                            Rectangle {
                                background: MaterialPalette.surface-variant;
                                border-radius: 4px;

                                HorizontalBox {
                                    padding: 10px;
                                    spacing: 10px;

                                    Text { text: "Маршрут"; font-weight: 700; horizontal-stretch: 2; color: MaterialPalette.on-background; }
                                    Text { text: "Продажи"; font-weight: 700; width: 80px; color: MaterialPalette.on-background; }
                                    Text { text: "Доход"; font-weight: 700; horizontal-stretch: 1; color: MaterialPalette.on-background; }
                                    Text { text: "Доля"; font-weight: 700; width: 80px; color: MaterialPalette.on-background; }
                                }
                            }

                            ScrollView {
                                height: 250px;
                                viewport-height: route_statistics.length * 45px;

                                VerticalBox {
                                    spacing: 2px;

                                    for stat[index] in route_statistics: Rectangle {
                                        height: 40px;
                                        background: mod(index, 2) == 0 ? MaterialPalette.surface : MaterialPalette.background;

                                        HorizontalBox {
                                            padding: 8px;
                                            spacing: 10px;

                                            Text { text: stat.route_name; horizontal-stretch: 2; color: MaterialPalette.on-background; vertical-alignment: center; overflow: elide; }
                                            Text { text: stat.total_sales; width: 80px; color: MaterialPalette.on-background; vertical-alignment: center; }
                                            Text { text: stat.total_revenue + " ₽"; horizontal-stretch: 1; color: MaterialPalette.on-background; vertical-alignment: center; }
                                            Text { text: stat.sales_percentage + "%"; width: 80px; color: MaterialPalette.on-background; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }

                            if route_statistics.length == 0: Text {
                                text: "Нет данных";
                                color: MaterialPalette.on-surface-variant;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
