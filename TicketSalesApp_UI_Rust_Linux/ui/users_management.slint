import { Button, VerticalBox, HorizontalBox, ScrollView, LineEdit, CheckBox, ComboBox } from "std-widgets.slint";
import { MaterialText, FilledButton, TonalButton } from "../material-1.0/material.slint";
import { MaterialPalette } from "../material-1.0/ui/styling/material_palette.slint";

// User data structure
export struct UserData {
    user-id: int,
    login: string,
    email: string,
    phone: string,
    role: int,
    role-name: string,
    is-active: bool,
    is-windows-auth: bool,
    windows-identity: string,
}

// Role option for dropdown
export struct RoleOption {
    value: int,
    label: string,
}

// Users Management View - CRUD operations for system users
export component UsersManagementView inherits Rectangle {
    in-out property <[UserData]> users: [];
    in-out property <UserData> selected-user: { 
        user-id: -1, 
        login: "", 
        email: "", 
        phone: "", 
        role: 1, 
        role-name: "",
        is-active: true,
        is-windows-auth: false,
        windows-identity: ""
    };
    in-out property <string> search-text: "";
    in-out property <bool> is-loading: false;
    in-out property <string> error-message: "";
    in-out property <bool> has-error: false;
    in-out property <bool> is-admin: false;
    in-out property <int> current-user-id: -1;
    
    // Dialog states
    in-out property <bool> show-add-dialog: false;
    in-out property <bool> show-edit-dialog: false;
    in-out property <bool> show-delete-dialog: false;
    
    // Dialog form fields
    in-out property <string> dialog-login: "";
    in-out property <string> dialog-password: "";
    in-out property <string> dialog-email: "";
    in-out property <string> dialog-phone: "";
    in-out property <int> dialog-role-index: 1;
    in-out property <bool> dialog-is-active: true;
    in-out property <bool> dialog-is-windows-auth: false;
    in-out property <string> dialog-windows-identity: "";
    
    // Role options
    in-out property <[RoleOption]> role-options: [
        { value: 0, label: "Администратор" },
        { value: 1, label: "Кассир" },
        { value: 2, label: "Контролёр" },
        { value: 3, label: "Старший кассир" }
    ];
    
    // Callbacks
    callback load-users();
    callback search-users(string);
    callback add-user(string, string, string, string, int, bool, bool, string);
    callback edit-user(int, string, string, string, string, int, bool, bool, string);
    callback delete-user(int);
    callback close-clicked();
    
    background: MaterialPalette.surface;
    
    VerticalBox {
        padding: 0px;
        
        // Header
        Rectangle {
            height: 64px;
            background: MaterialPalette.surface-container-highest;
            
            HorizontalBox {
                padding: 16px;
                spacing: 16px;
                
                MaterialText {
                    text: "Управление пользователями";
                    font-size: 20px;
                    font-weight: 600;
                    color: MaterialPalette.on-surface;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                
                if !root.is-admin: MaterialText {
                    text: "(Только для администраторов)";
                    font-size: 14px;
                    color: MaterialPalette.error;
                    vertical-alignment: center;
                }
                
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: close-touch.has-hover ? MaterialPalette.surface-container : transparent;
                    
                    close-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => { root.close-clicked(); }
                    }
                    
                    Path {
                        width: 20px;
                        height: 20px;
                        x: 10px;
                        y: 10px;
                        fill: MaterialPalette.on-surface;
                        commands: "M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41z";
                    }
                }
            }
        }
        
        // Content
        VerticalBox {
            padding: 16px;
            spacing: 16px;
            
            // Search and Actions Bar
            HorizontalBox {
                spacing: 16px;
                
                Rectangle {
                    horizontal-stretch: 1;
                    height: 48px;
                    background: MaterialPalette.surface-container;
                    border-radius: 24px;
                    
                    HorizontalBox {
                        padding-left: 20px;
                        padding-right: 20px;
                        spacing: 12px;
                        
                        Path {
                            width: 20px;
                            height: 20px;
                            fill: MaterialPalette.on-surface-variant;
                            commands: "M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z";
                        }
                        
                        search-input := LineEdit {
                            horizontal-stretch: 1;
                            placeholder-text: "Поиск по логину или email...";
                            text <=> root.search-text;
                            edited => { root.search-users(self.text); }
                        }
                    }
                }
                
                if root.is-admin: FilledButton {
                    text: "Добавить пользователя";
                    enabled: !root.is-loading;
                    clicked => {
                        root.dialog-login = "";
                        root.dialog-password = "";
                        root.dialog-email = "";
                        root.dialog-phone = "";
                        root.dialog-role-index = 1;
                        root.dialog-is-active = true;
                        root.dialog-is-windows-auth = false;
                        root.dialog-windows-identity = "";
                        root.show-add-dialog = true;
                    }
                }
                
                TonalButton {
                    text: "Обновить";
                    enabled: !root.is-loading;
                    clicked => { root.load-users(); }
                }
            }
            
            // Error message
            if root.has-error: Rectangle {
                height: 48px;
                background: MaterialPalette.error-container;
                border-radius: 8px;
                
                HorizontalBox {
                    padding: 12px;
                    spacing: 8px;
                    
                    Path {
                        width: 20px;
                        height: 20px;
                        fill: MaterialPalette.on-error-container;
                        commands: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z";
                    }
                    
                    MaterialText {
                        text: root.error-message;
                        color: MaterialPalette.on-error-container;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
            }
            
            // Users List
            Rectangle {
                background: MaterialPalette.surface-container-low;
                border-radius: 12px;
                vertical-stretch: 1;
                
                if root.is-loading: VerticalBox {
                    alignment: center;
                    
                    MaterialText {
                        text: "Загрузка...";
                        font-size: 16px;
                        color: MaterialPalette.on-surface-variant;
                        horizontal-alignment: center;
                    }
                }
                
                if !root.is-loading && root.users.length == 0: VerticalBox {
                    alignment: center;
                    
                    MaterialText {
                        text: "Нет пользователей";
                        font-size: 16px;
                        color: MaterialPalette.on-surface-variant;
                        horizontal-alignment: center;
                    }
                }
                
                if !root.is-loading && root.users.length > 0: ScrollView {
                    VerticalBox {
                        padding: 0px;
                        
                        // Table Header
                        Rectangle {
                            height: 48px;
                            background: MaterialPalette.surface-container-highest;
                            
                            HorizontalBox {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 16px;
                                
                                MaterialText {
                                    text: "ID";
                                    font-weight: 600;
                                    color: MaterialPalette.on-surface;
                                    vertical-alignment: center;
                                    width: 50px;
                                }
                                
                                MaterialText {
                                    text: "Логин";
                                    font-weight: 600;
                                    color: MaterialPalette.on-surface;
                                    vertical-alignment: center;
                                    horizontal-stretch: 2;
                                }
                                
                                MaterialText {
                                    text: "Email";
                                    font-weight: 600;
                                    color: MaterialPalette.on-surface;
                                    vertical-alignment: center;
                                    horizontal-stretch: 2;
                                }
                                
                                MaterialText {
                                    text: "Телефон";
                                    font-weight: 600;
                                    color: MaterialPalette.on-surface;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                
                                MaterialText {
                                    text: "Роль";
                                    font-weight: 600;
                                    color: MaterialPalette.on-surface;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                
                                MaterialText {
                                    text: "Статус";
                                    font-weight: 600;
                                    color: MaterialPalette.on-surface;
                                    vertical-alignment: center;
                                    width: 80px;
                                }
                                
                                if root.is-admin: Rectangle {
                                    width: 120px;
                                }
                            }
                        }
                        
                        // Table Rows
                        for user[index] in root.users: Rectangle {
                            height: 64px;
                            background: mod(index, 2) == 0 ? MaterialPalette.surface : MaterialPalette.surface-container-low;
                            
                            HorizontalBox {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 16px;
                                
                                MaterialText {
                                    text: user.user-id;
                                    color: MaterialPalette.on-surface;
                                    vertical-alignment: center;
                                    width: 50px;
                                }
                                
                                MaterialText {
                                    text: user.login;
                                    color: MaterialPalette.on-surface;
                                    vertical-alignment: center;
                                    horizontal-stretch: 2;
                                    overflow: elide;
                                }
                                
                                MaterialText {
                                    text: user.email != "" ? user.email : "-";
                                    color: MaterialPalette.on-surface-variant;
                                    vertical-alignment: center;
                                    horizontal-stretch: 2;
                                    overflow: elide;
                                }
                                
                                MaterialText {
                                    text: user.phone != "" ? user.phone : "-";
                                    color: MaterialPalette.on-surface-variant;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                
                                MaterialText {
                                    text: user.role-name;
                                    color: MaterialPalette.on-surface-variant;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                
                                Rectangle {
                                    width: 80px;
                                    
                                    Rectangle {
                                        width: 60px;
                                        height: 24px;
                                        border-radius: 12px;
                                        background: user.is-active ? MaterialPalette.primary-container : MaterialPalette.error-container;
                                        
                                        MaterialText {
                                            text: user.is-active ? "Активен" : "Неактивен";
                                            font-size: 12px;
                                            color: user.is-active ? MaterialPalette.on-primary-container : MaterialPalette.on-error-container;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                
                                if root.is-admin: HorizontalBox {
                                    width: 120px;
                                    spacing: 8px;
                                    
                                    TonalButton {
                                        text: "✏️";
                                        enabled: !root.is-loading;
                                        clicked => {
                                            root.selected-user = user;
                                            root.dialog-login = user.login;
                                            root.dialog-password = "";
                                            root.dialog-email = user.email;
                                            root.dialog-phone = user.phone;
                                            root.dialog-role-index = user.role;
                                            root.dialog-is-active = user.is-active;
                                            root.dialog-is-windows-auth = user.is-windows-auth;
                                            root.dialog-windows-identity = user.windows-identity;
                                            root.show-edit-dialog = true;
                                        }
                                    }
                                    
                                    TonalButton {
                                        text: "🗑️";
                                        enabled: !root.is-loading && user.user-id != root.current-user-id;
                                        clicked => {
                                            root.selected-user = user;
                                            root.show-delete-dialog = true;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    
    // Add User Dialog
    if root.show-add-dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000080;
        
        TouchArea {
            clicked => { root.show-add-dialog = false; }
        }
        
        Rectangle {
            width: 600px;
            height: 600px;
            background: MaterialPalette.surface;
            border-radius: 16px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            
            TouchArea { } // Prevent clicks from closing dialog
            
            ScrollView {
                VerticalBox {
                    padding: 24px;
                    spacing: 16px;
                    
                    MaterialText {
                        text: "Добавить пользователя";
                        font-size: 20px;
                        font-weight: 600;
                        color: MaterialPalette.on-surface;
                    }
                    
                    VerticalBox {
                        spacing: 12px;
                        
                        MaterialText {
                            text: "Логин *";
                            color: MaterialPalette.on-surface-variant;
                        }
                        
                        LineEdit {
                            text <=> root.dialog-login;
                            placeholder-text: "Введите логин";
                        }
                    }
                    
                    VerticalBox {
                        spacing: 12px;
                        
                        MaterialText {
                            text: "Пароль *";
                            color: MaterialPalette.on-surface-variant;
                        }
                        
                        LineEdit {
                            text <=> root.dialog-password;
                            placeholder-text: "Введите пароль";
                            input-type: password;
                        }
                    }
                    
                    VerticalBox {
                        spacing: 12px;
                        
                        MaterialText {
                            text: "Email";
                            color: MaterialPalette.on-surface-variant;
                        }
                        
                        LineEdit {
                            text <=> root.dialog-email;
                            placeholder-text: "Введите email";
                        }
                    }
                    
                    VerticalBox {
                        spacing: 12px;
                        
                        MaterialText {
                            text: "Телефон";
                            color: MaterialPalette.on-surface-variant;
                        }
                        
                        LineEdit {
                            text <=> root.dialog-phone;
                            placeholder-text: "Введите телефон";
                        }
                    }
                    
                    VerticalBox {
                        spacing: 12px;
                        
                        MaterialText {
                            text: "Роль *";
                            color: MaterialPalette.on-surface-variant;
                        }
                        
                        ComboBox {
                            model: ["Администратор", "Кассир", "Контролёр", "Старший кассир"];
                            current-index <=> root.dialog-role-index;
                        }
                    }
                    
                    HorizontalBox {
                        spacing: 12px;
                        
                        CheckBox {
                            text: "Windows аутентификация";
                            checked <=> root.dialog-is-windows-auth;
                        }
                    }
                    
                    if root.dialog-is-windows-auth: VerticalBox {
                        spacing: 12px;
                        
                        MaterialText {
                            text: "Windows Identity";
                            color: MaterialPalette.on-surface-variant;
                        }
                        
                        LineEdit {
                            text <=> root.dialog-windows-identity;
                            placeholder-text: "DOMAIN\\username";
                        }
                    }
                    
                    HorizontalBox {
                        spacing: 12px;
                        
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        
                        TonalButton {
                            text: "Отмена";
                            clicked => { root.show-add-dialog = false; }
                        }
                        
                        FilledButton {
                            text: "Сохранить";
                            enabled: root.dialog-login != "" && root.dialog-password != "";
                            clicked => {
                                root.add-user(
                                    root.dialog-login,
                                    root.dialog-password,
                                    root.dialog-email,
                                    root.dialog-phone,
                                    root.dialog-role-index,
                                    root.dialog-is-active,
                                    root.dialog-is-windows-auth,
                                    root.dialog-windows-identity
                                );
                                root.show-add-dialog = false;
                            }
                        }
                    }
                }
            }
        }
    }
    
    // Edit User Dialog
    if root.show-edit-dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000080;
        
        TouchArea {
            clicked => { root.show-edit-dialog = false; }
        }
        
        Rectangle {
            width: 600px;
            height: 650px;
            background: MaterialPalette.surface;
            border-radius: 16px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            
            TouchArea { } // Prevent clicks from closing dialog
            
            ScrollView {
                VerticalBox {
                    padding: 24px;
                    spacing: 16px;
                    
                    MaterialText {
                        text: "Редактировать пользователя";
                        font-size: 20px;
                        font-weight: 600;
                        color: MaterialPalette.on-surface;
                    }
                    
                    VerticalBox {
                        spacing: 12px;
                        
                        MaterialText {
                            text: "Логин *";
                            color: MaterialPalette.on-surface-variant;
                        }
                        
                        LineEdit {
                            text <=> root.dialog-login;
                            placeholder-text: "Введите логин";
                        }
                    }
                    
                    VerticalBox {
                        spacing: 12px;
                        
                        MaterialText {
                            text: "Новый пароль (оставьте пустым, чтобы не менять)";
                            color: MaterialPalette.on-surface-variant;
                        }
                        
                        LineEdit {
                            text <=> root.dialog-password;
                            placeholder-text: "Введите новый пароль";
                            input-type: password;
                        }
                    }
                    
                    VerticalBox {
                        spacing: 12px;
                        
                        MaterialText {
                            text: "Email";
                            color: MaterialPalette.on-surface-variant;
                        }
                        
                        LineEdit {
                            text <=> root.dialog-email;
                            placeholder-text: "Введите email";
                        }
                    }
                    
                    VerticalBox {
                        spacing: 12px;
                        
                        MaterialText {
                            text: "Телефон";
                            color: MaterialPalette.on-surface-variant;
                        }
                        
                        LineEdit {
                            text <=> root.dialog-phone;
                            placeholder-text: "Введите телефон";
                        }
                    }
                    
                    VerticalBox {
                        spacing: 12px;
                        
                        MaterialText {
                            text: "Роль *";
                            color: MaterialPalette.on-surface-variant;
                        }
                        
                        ComboBox {
                            model: ["Администратор", "Кассир", "Контролёр", "Старший кассир"];
                            current-index <=> root.dialog-role-index;
                        }
                    }
                    
                    HorizontalBox {
                        spacing: 12px;
                        
                        CheckBox {
                            text: "Активен";
                            checked <=> root.dialog-is-active;
                        }
                    }
                    
                    HorizontalBox {
                        spacing: 12px;
                        
                        CheckBox {
                            text: "Windows аутентификация";
                            checked <=> root.dialog-is-windows-auth;
                        }
                    }
                    
                    if root.dialog-is-windows-auth: VerticalBox {
                        spacing: 12px;
                        
                        MaterialText {
                            text: "Windows Identity";
                            color: MaterialPalette.on-surface-variant;
                        }
                        
                        LineEdit {
                            text <=> root.dialog-windows-identity;
                            placeholder-text: "DOMAIN\\username";
                        }
                    }
                    
                    HorizontalBox {
                        spacing: 12px;
                        
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        
                        TonalButton {
                            text: "Отмена";
                            clicked => { root.show-edit-dialog = false; }
                        }
                        
                        FilledButton {
                            text: "Сохранить";
                            enabled: root.dialog-login != "";
                            clicked => {
                                root.edit-user(
                                    root.selected-user.user-id,
                                    root.dialog-login,
                                    root.dialog-password,
                                    root.dialog-email,
                                    root.dialog-phone,
                                    root.dialog-role-index,
                                    root.dialog-is-active,
                                    root.dialog-is-windows-auth,
                                    root.dialog-windows-identity
                                );
                                root.show-edit-dialog = false;
                            }
                        }
                    }
                }
            }
        }
    }
    
    // Delete Confirmation Dialog
    if root.show-delete-dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000080;
        
        TouchArea {
            clicked => { root.show-delete-dialog = false; }
        }
        
        Rectangle {
            width: 400px;
            height: 220px;
            background: MaterialPalette.surface;
            border-radius: 16px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            
            TouchArea { } // Prevent clicks from closing dialog
            
            VerticalBox {
                padding: 24px;
                spacing: 16px;
                
                MaterialText {
                    text: "Удалить пользователя?";
                    font-size: 20px;
                    font-weight: 600;
                    color: MaterialPalette.on-surface;
                }
                
                MaterialText {
                    text: "Вы уверены, что хотите удалить пользователя \"" + root.selected-user.login + "\"?";
                    color: MaterialPalette.on-surface-variant;
                    wrap: word-wrap;
                }
                
                if root.selected-user.user-id == root.current-user-id: MaterialText {
                    text: "⚠️ Вы не можете удалить свою учётную запись!";
                    color: MaterialPalette.error;
                    wrap: word-wrap;
                }
                
                Rectangle {
                    vertical-stretch: 1;
                }
                
                HorizontalBox {
                    spacing: 12px;
                    
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    
                    TonalButton {
                        text: "Отмена";
                        clicked => { root.show-delete-dialog = false; }
                    }
                    
                    FilledButton {
                        text: "Удалить";
                        enabled: root.selected-user.user-id != root.current-user-id;
                        clicked => {
                            root.delete-user(root.selected-user.user-id);
                            root.show-delete-dialog = false;
                        }
                    }
                }
            }
        }
    }
}
