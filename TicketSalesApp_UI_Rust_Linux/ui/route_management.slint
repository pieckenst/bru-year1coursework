import { Button, VerticalBox, HorizontalBox, ScrollView, ComboBox } from "std-widgets.slint";
import { MaterialText, FilledButton, TonalButton } from "../material-1.0/material.slint";
import { MaterialPalette } from "../material-1.0/ui/styling/material_palette.slint";
import { LineEdit } from "std-widgets.slint";

// Route data structure
export struct RouteData {
    route-id: int,
    start-point: string,
    end-point: string,
    bus-model: string,
    driver-name: string,
    travel-time: string,
}

// Route Management View - CRUD operations for routes
export component RouteManagementView inherits Rectangle {
    in-out property <[RouteData]> routes: [];
    in-out property <RouteData> selected-route: { 
        route-id: -1, 
        start-point: "", 
        end-point: "", 
        bus-model: "", 
        driver-name: "", 
        travel-time: "" 
    };
    in-out property <string> search-text: "";
    in-out property <bool> is-loading: false;
    in-out property <string> error-message: "";
    in-out property <bool> has-error: false;
    
    // Dialog states
    in-out property <bool> show-add-dialog: false;
    in-out property <bool> show-edit-dialog: false;
    in-out property <bool> show-delete-dialog: false;
    
    // Dialog form fields
    in-out property <string> dialog-start-point: "";
    in-out property <string> dialog-end-point: "";
    in-out property <string> dialog-travel-time: "";
    in-out property <int> dialog-selected-bus-index: -1;
    in-out property <int> dialog-selected-driver-index: -1;
    
    // Dropdown options
    in-out property <[string]> bus-options: [];
    in-out property <[string]> driver-options: [];
    
    // Callbacks
    callback load-routes();
    callback search-routes(string);
    callback add-route(string, string, string, int, int);
    callback edit-route(int, string, string, string, int, int);
    callback delete-route(int);
    callback close-clicked();
    callback load-dropdown-data();
    
    background: MaterialPalette.surface;
    
    VerticalBox {
        padding: 0px;
        
        // Header
        Rectangle {
            height: 64px;
            background: MaterialPalette.surface-container-highest;
            
            HorizontalBox {
                padding: 16px;
                spacing: 16px;
                
                MaterialText {
                    text: "Управление маршрутами";
                    font-size: 20px;
                    font-weight: 600;
                    color: MaterialPalette.on-surface;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: close-touch.has-hover ? MaterialPalette.surface-container : transparent;
                    
                    close-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => { root.close-clicked(); }
                    }
                    
                    Path {
                        width: 20px;
                        height: 20px;
                        x: 10px;
                        y: 10px;
                        fill: MaterialPalette.on-surface;
                        commands: "M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41z";
                    }
                }
            }
        }
        
        // Content
        VerticalBox {
            padding: 16px;
            spacing: 16px;
            
            // Search and Actions Bar
            HorizontalBox {
                spacing: 16px;
                
                Rectangle {
                    horizontal-stretch: 1;
                    height: 48px;
                    background: MaterialPalette.surface-container;
                    border-radius: 24px;
                    
                    HorizontalBox {
                        padding: 16px;
                        spacing: 12px;
                        
                        Path {
                            width: 20px;
                            height: 20px;
                            fill: MaterialPalette.on-surface-variant;
                            commands: "M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z";
                        }
                        
                        LineEdit {
                            horizontal-stretch: 1;
                            text: root.search-text;
                            placeholder-text: "Поиск маршрутов...";
                            font-size: 14px;
                            
                            edited(text) => {
                                root.search-text = text;
                                root.search-routes(text);
                            }
                        }
                    }
                }
                
                FilledButton {
                    text: "Добавить";
                    min-width: 120px;
                    height: 48px;
                    
                    clicked => {
                        root.dialog-start-point = "";
                        root.dialog-end-point = "";
                        root.dialog-travel-time = "";
                        root.dialog-selected-bus-index = -1;
                        root.dialog-selected-driver-index = -1;
                        root.load-dropdown-data();
                        root.show-add-dialog = true;
                    }
                }
            }
            
            // Error Message
            if root.has-error: Rectangle {
                height: 48px;
                background: MaterialPalette.error-container;
                border-radius: 8px;
                
                HorizontalBox {
                    padding: 16px;
                    spacing: 12px;
                    
                    Path {
                        width: 20px;
                        height: 20px;
                        fill: MaterialPalette.on-error-container;
                        commands: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z";
                    }
                    
                    MaterialText {
                        text: root.error-message;
                        color: MaterialPalette.on-error-container;
                        font-size: 14px;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
            
            // Loading Indicator
            if root.is-loading: Rectangle {
                height: 80px;
                
                MaterialText {
                    text: "Загрузка...";
                    font-size: 16px;
                    color: MaterialPalette.on-surface-variant;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            
            // Route List
            if !root.is-loading: ScrollView {
                VerticalBox {
                    spacing: 8px;
                    
                    // Empty State
                    if root.routes.length == 0: Rectangle {
                        height: 120px;
                        background: MaterialPalette.surface-container;
                        border-radius: 12px;
                        
                        VerticalBox {
                            padding: 24px;
                            spacing: 8px;
                            
                            Path {
                                width: 32px;
                                height: 32px;
                                x: parent.width / 2 - 16px;
                                fill: MaterialPalette.on-surface-variant;
                                commands: "M12 2L4.5 20.29l.71.71L12 18l6.79 3 .71-.71z";
                            }
                            
                            MaterialText {
                                text: "Нет маршрутов";
                                font-size: 16px;
                                font-weight: 500;
                                color: MaterialPalette.on-surface-variant;
                                horizontal-alignment: center;
                            }
                            
                            MaterialText {
                                text: "Добавьте первый маршрут, чтобы начать";
                                font-size: 14px;
                                color: MaterialPalette.on-surface-variant;
                                horizontal-alignment: center;
                            }
                        }
                    }
                    
                    // Route Cards
                    for route[idx] in root.routes: Rectangle {
                        height: 100px;
                        background: root.selected-route.route-id == route.route-id ? MaterialPalette.secondary-container : MaterialPalette.surface-container;
                        border-radius: 12px;
                        
                        route-touch := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.selected-route = route;
                            }
                        }
                        
                        HorizontalBox {
                            padding: 16px;
                            spacing: 16px;
                            
                            // Route Icon
                            Rectangle {
                                width: 48px;
                                height: 48px;
                                border-radius: 24px;
                                background: MaterialPalette.primary;
                                
                                Path {
                                    width: 24px;
                                    height: 24px;
                                    x: 12px;
                                    y: 12px;
                                    fill: MaterialPalette.on-primary;
                                    commands: "M12 2L4.5 20.29l.71.71L12 18l6.79 3 .71-.71z";
                                }
                            }
                            
                            // Route Info
                            VerticalBox {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                
                                MaterialText {
                                    text: route.start-point + " → " + route.end-point;
                                    font-size: 16px;
                                    font-weight: 600;
                                    color: root.selected-route.route-id == route.route-id ? MaterialPalette.on-secondary-container : MaterialPalette.on-surface;
                                }
                                
                                MaterialText {
                                    text: "Автобус: " + route.bus-model;
                                    font-size: 14px;
                                    color: root.selected-route.route-id == route.route-id ? MaterialPalette.on-secondary-container : MaterialPalette.on-surface-variant;
                                }
                                
                                MaterialText {
                                    text: "Водитель: " + route.driver-name;
                                    font-size: 14px;
                                    color: root.selected-route.route-id == route.route-id ? MaterialPalette.on-secondary-container : MaterialPalette.on-surface-variant;
                                }
                                
                                if route.travel-time != "": MaterialText {
                                    text: "Время в пути: " + route.travel-time;
                                    font-size: 14px;
                                    color: root.selected-route.route-id == route.route-id ? MaterialPalette.on-secondary-container : MaterialPalette.on-surface-variant;
                                }
                            }
                            
                            // Action Buttons
                            HorizontalBox {
                                spacing: 8px;
                                
                                TonalButton {
                                    text: "Изменить";
                                    min-width: 80px;
                                    height: 36px;
                                    
                                    clicked => {
                                        root.selected-route = route;
                                        root.dialog-start-point = route.start-point;
                                        root.dialog-end-point = route.end-point;
                                        root.dialog-travel-time = route.travel-time;
                                        root.load-dropdown-data();
                                        root.show-edit-dialog = true;
                                    }
                                }
                                
                                TonalButton {
                                    text: "Удалить";
                                    min-width: 80px;
                                    height: 36px;
                                    
                                    clicked => {
                                        root.selected-route = route;
                                        root.show-delete-dialog = true;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    
    // Add Route Dialog
    if root.show-add-dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000080;
        
        Rectangle {
            width: 500px;
            height: 450px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: MaterialPalette.surface;
            border-radius: 12px;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000040;
            
            VerticalBox {
                padding: 24px;
                spacing: 16px;
                
                MaterialText {
                    text: "Добавить маршрут";
                    font-size: 18px;
                    font-weight: 600;
                    color: MaterialPalette.on-surface;
                }
                
                LineEdit {
                    text: root.dialog-start-point;
                    placeholder-text: "Начальная точка";
                    
                    edited(text) => {
                        root.dialog-start-point = text;
                    }
                }
                
                LineEdit {
                    text: root.dialog-end-point;
                    placeholder-text: "Конечная точка";
                    
                    edited(text) => {
                        root.dialog-end-point = text;
                    }
                }
                
                LineEdit {
                    text: root.dialog-travel-time;
                    placeholder-text: "Время в пути (например, 2:30)";
                    
                    edited(text) => {
                        root.dialog-travel-time = text;
                    }
                }
                
                VerticalBox {
                    spacing: 8px;
                    
                    MaterialText {
                        text: "Автобус:";
                        font-size: 14px;
                        color: MaterialPalette.on-surface;
                    }
                    
                    ComboBox {
                        model: root.bus-options;
                        current-index <=> root.dialog-selected-bus-index;
                    }
                }
                
                VerticalBox {
                    spacing: 8px;
                    
                    MaterialText {
                        text: "Водитель:";
                        font-size: 14px;
                        color: MaterialPalette.on-surface;
                    }
                    
                    ComboBox {
                        model: root.driver-options;
                        current-index <=> root.dialog-selected-driver-index;
                    }
                }
                
                HorizontalBox {
                    spacing: 12px;
                    
                    Rectangle { horizontal-stretch: 1; }
                    
                    TonalButton {
                        text: "Отмена";
                        
                        clicked => {
                            root.show-add-dialog = false;
                            root.dialog-start-point = "";
                            root.dialog-end-point = "";
                            root.dialog-travel-time = "";
                            root.dialog-selected-bus-index = -1;
                            root.dialog-selected-driver-index = -1;
                        }
                    }
                    
                    FilledButton {
                        text: "Добавить";
                        
                        clicked => {
                            if root.dialog-start-point != "" && root.dialog-end-point != "" && 
                               root.dialog-selected-bus-index >= 0 && root.dialog-selected-driver-index >= 0 {
                                root.add-route(
                                    root.dialog-start-point,
                                    root.dialog-end-point,
                                    root.dialog-travel-time,
                                    root.dialog-selected-bus-index,
                                    root.dialog-selected-driver-index
                                );
                                root.show-add-dialog = false;
                                root.dialog-start-point = "";
                                root.dialog-end-point = "";
                                root.dialog-travel-time = "";
                                root.dialog-selected-bus-index = -1;
                                root.dialog-selected-driver-index = -1;
                            }
                        }
                    }
                }
            }
        }
    }
    
    // Edit Route Dialog
    if root.show-edit-dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000080;
        
        Rectangle {
            width: 500px;
            height: 450px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: MaterialPalette.surface;
            border-radius: 12px;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000040;
            
            VerticalBox {
                padding: 24px;
                spacing: 16px;
                
                MaterialText {
                    text: "Изменить маршрут";
                    font-size: 18px;
                    font-weight: 600;
                    color: MaterialPalette.on-surface;
                }
                
                LineEdit {
                    text: root.dialog-start-point;
                    placeholder-text: "Начальная точка";
                    
                    edited(text) => {
                        root.dialog-start-point = text;
                    }
                }
                
                LineEdit {
                    text: root.dialog-end-point;
                    placeholder-text: "Конечная точка";
                    
                    edited(text) => {
                        root.dialog-end-point = text;
                    }
                }
                
                LineEdit {
                    text: root.dialog-travel-time;
                    placeholder-text: "Время в пути (например, 2:30)";
                    
                    edited(text) => {
                        root.dialog-travel-time = text;
                    }
                }
                
                VerticalBox {
                    spacing: 8px;
                    
                    MaterialText {
                        text: "Автобус:";
                        font-size: 14px;
                        color: MaterialPalette.on-surface;
                    }
                    
                    ComboBox {
                        model: root.bus-options;
                        current-index <=> root.dialog-selected-bus-index;
                    }
                }
                
                VerticalBox {
                    spacing: 8px;
                    
                    MaterialText {
                        text: "Водитель:";
                        font-size: 14px;
                        color: MaterialPalette.on-surface;
                    }
                    
                    ComboBox {
                        model: root.driver-options;
                        current-index <=> root.dialog-selected-driver-index;
                    }
                }
                
                HorizontalBox {
                    spacing: 12px;
                    
                    Rectangle { horizontal-stretch: 1; }
                    
                    TonalButton {
                        text: "Отмена";
                        
                        clicked => {
                            root.show-edit-dialog = false;
                            root.dialog-start-point = "";
                            root.dialog-end-point = "";
                            root.dialog-travel-time = "";
                            root.dialog-selected-bus-index = -1;
                            root.dialog-selected-driver-index = -1;
                        }
                    }
                    
                    FilledButton {
                        text: "Сохранить";
                        
                        clicked => {
                            if root.dialog-start-point != "" && root.dialog-end-point != "" && 
                               root.dialog-selected-bus-index >= 0 && root.dialog-selected-driver-index >= 0 {
                                root.edit-route(
                                    root.selected-route.route-id,
                                    root.dialog-start-point,
                                    root.dialog-end-point,
                                    root.dialog-travel-time,
                                    root.dialog-selected-bus-index,
                                    root.dialog-selected-driver-index
                                );
                                root.show-edit-dialog = false;
                                root.dialog-start-point = "";
                                root.dialog-end-point = "";
                                root.dialog-travel-time = "";
                                root.dialog-selected-bus-index = -1;
                                root.dialog-selected-driver-index = -1;
                            }
                        }
                    }
                }
            }
        }
    }
    
    // Delete Route Dialog
    if root.show-delete-dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000080;
        
        Rectangle {
            width: 400px;
            height: 200px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: MaterialPalette.surface;
            border-radius: 12px;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000040;
            
            VerticalBox {
                padding: 24px;
                spacing: 16px;
                
                MaterialText {
                    text: "Удалить маршрут";
                    font-size: 18px;
                    font-weight: 600;
                    color: MaterialPalette.on-surface;
                }
                
                MaterialText {
                    text: "Вы уверены, что хотите удалить маршрут \"" + root.selected-route.start-point + " → " + root.selected-route.end-point + "\"?";
                    font-size: 14px;
                    color: MaterialPalette.on-surface-variant;
                    wrap: word-wrap;
                }
                
                HorizontalBox {
                    spacing: 12px;
                    
                    Rectangle { horizontal-stretch: 1; }
                    
                    TonalButton {
                        text: "Отмена";
                        
                        clicked => {
                            root.show-delete-dialog = false;
                        }
                    }
                    
                    FilledButton {
                        text: "Удалить";
                        
                        clicked => {
                            root.delete-route(root.selected-route.route-id);
                            root.show-delete-dialog = false;
                        }
                    }
                }
            }
        }
    }
}
