import { Button, VerticalBox, HorizontalBox, LineEdit } from "std-widgets.slint";
import { FilledButton, MaterialPalette, MaterialText } from "../material-1.0/material.slint";

// Modern Material Design 3 Login Window
export component AuthWindow inherits Window {
    title: "Вход в систему - Автопарк автобусов";
    width: 900px;
    height: 600px;
    default-font-family: "Arial";
    
    // Gradient background
    Rectangle {
        background: @linear-gradient(135deg, #1A1A2E 0%, #16213E 50%, #0F3460 100%);
    }
    
    // Properties
    in-out property <string> username;
    in-out property <string> password;
    in-out property <string> error-message;
    in-out property <bool> is-loading: false;
    
    // Callbacks
    callback login-clicked();
    
    // Main Layout - Two Columns
    HorizontalBox {
        // Left Side - Features Panel
        VerticalBox {
            horizontal-stretch: 1;
            padding: 40px;
            spacing: 20px;
            
            // Top Section - Logo and Title
            VerticalBox {
                vertical-stretch: 1;
                spacing: 20px;
                
                // Bus Icon with proper SVG and glow effect
                Rectangle {
                    width: 120px;
                    height: 120px;
                    border-radius: 60px;
                    background: @linear-gradient(135deg, #7E57C2 0%, #673AB7 100%);
                    drop-shadow-blur: 20px;
                    drop-shadow-color: #673AB740;
                    drop-shadow-offset-y: 4px;
                    
                    Path {
                        width: 64px;
                        height: 64px;
                        x: 28px;
                        y: 28px;
                        fill: Colors.white;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: "M4 16c0 .88.39 1.67 1 2.22V20c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h8v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1.78c.61-.55 1-1.34 1-2.22V6c0-3.5-3.58-4-8-4s-8 .5-8 4v10zm3.5 1c-.83 0-1.5-.67-1.5-1.5S6.67 14 7.5 14s1.5.67 1.5 1.5S8.33 17 7.5 17zm9 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm1.5-6H6V6.85c.52-.86 2.24-1.85 6-1.85s5.48.99 6 1.85V11z";
                    }
                }
                
                MaterialText {
                    text: "Автопарк автобусов";
                    font-size: 32px;
                    font-weight: 700;
                    color: Colors.white;
                    horizontal-alignment: center;
                }
                
                MaterialText {
                    text: "Система управления автопарком и продажей билетов";
                    font-size: 18px;
                    color: Colors.white;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
            
            // Bottom Section - Features List
            VerticalBox {
                spacing: 10px;
                
                MaterialText {
                    text: "Возможности системы:";
                    font-size: 16px;
                    font-weight: 600;
                    color: Colors.white;
                }
                
                // Feature 1
                Rectangle {
                    height: 40px;
                    background: #FFFFFF08;
                    border-radius: 8px;
                    
                    HorizontalBox {
                        padding: 10px;
                        spacing: 12px;
                        
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: MaterialPalette.primary;
                            
                            MaterialText {
                                text: "✓";
                                font-size: 16px;
                                color: Colors.white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        
                        MaterialText {
                            text: "Управление автопарком и маршрутами";
                            color: Colors.white;
                            font-size: 15px;
                            vertical-alignment: center;
                        }
                    }
                }
                
                // Feature 2
                Rectangle {
                    height: 40px;
                    background: #FFFFFF08;
                    border-radius: 8px;
                    
                    HorizontalBox {
                        padding: 10px;
                        spacing: 12px;
                        
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: MaterialPalette.primary;
                            
                            MaterialText {
                                text: "✓";
                                font-size: 16px;
                                color: Colors.white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        
                        MaterialText {
                            text: "Продажа и учет билетов";
                            color: Colors.white;
                            font-size: 15px;
                            vertical-alignment: center;
                        }
                    }
                }
                
                // Feature 3
                Rectangle {
                    height: 40px;
                    background: #FFFFFF08;
                    border-radius: 8px;
                    
                    HorizontalBox {
                        padding: 10px;
                        spacing: 12px;
                        
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: MaterialPalette.primary;
                            
                            MaterialText {
                                text: "✓";
                                font-size: 16px;
                                color: Colors.white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        
                        MaterialText {
                            text: "Контроль технического обслуживания";
                            color: Colors.white;
                            font-size: 15px;
                            vertical-alignment: center;
                        }
                    }
                }
                
                // Feature 4
                Rectangle {
                    height: 40px;
                    background: #FFFFFF08;
                    border-radius: 8px;
                    
                    HorizontalBox {
                        padding: 10px;
                        spacing: 12px;
                        
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: MaterialPalette.primary;
                            
                            MaterialText {
                                text: "✓";
                                font-size: 16px;
                                color: Colors.white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        
                        MaterialText {
                            text: "Статистика и аналитика";
                            color: Colors.white;
                            font-size: 15px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
        
        // Right Side - Login Form Panel
        Rectangle {
            width: 380px;
            background: #1E1E1E;
            drop-shadow-blur: 30px;
            drop-shadow-color: #00000080;
            drop-shadow-offset-x: -5px;
            
            VerticalBox {
                padding: 40px;
                spacing: 30px;
                
                // Header Section
                VerticalBox {
                    spacing: 10px;
                    
                    MaterialText {
                        text: "Вход в систему";
                        font-size: 24px;
                        font-weight: 700;
                        color: Colors.white;
                    }
                    
                    MaterialText {
                        text: "Введите ваши учетные данные";
                        font-size: 14px;
                        color: #808080;
                    }
                }
                
                // Login Form
                VerticalBox {
                    vertical-stretch: 1;
                    spacing: 25px;
                    
                    // Username Field
                    VerticalBox {
                        spacing: 8px;
                        
                        MaterialText {
                            text: "Логин";
                            font-size: 14px;
                            font-weight: 500;
                            color: Colors.white;
                        }
                        
                        Rectangle {
                            height: 48px;
                            background: username-field.has-focus ? MaterialPalette.surface-container-high : MaterialPalette.surface-container-highest;
                            border-radius: 8px;
                            border-width: username-field.has-focus ? 2px : 1px;
                            border-color: username-field.has-focus ? MaterialPalette.primary : #3A3A3A;
                            
                            animate background, border-color {
                                duration: 200ms;
                                easing: ease-in-out;
                            }
                            
                            username-field := LineEdit {
                                text <=> root.username;
                                placeholder-text: "Введите логин";
                                enabled: !root.is-loading;
                                font-size: 15px;
                            }
                        }
                    }
                    
                    // Password Field
                    VerticalBox {
                        spacing: 8px;
                        
                        MaterialText {
                            text: "Пароль";
                            font-size: 14px;
                            font-weight: 500;
                            color: Colors.white;
                        }
                        
                        Rectangle {
                            height: 48px;
                            background: password-field.has-focus ? MaterialPalette.surface-container-high : MaterialPalette.surface-container-highest;
                            border-radius: 8px;
                            border-width: password-field.has-focus ? 2px : 1px;
                            border-color: password-field.has-focus ? MaterialPalette.primary : #3A3A3A;
                            
                            animate background, border-color {
                                duration: 200ms;
                                easing: ease-in-out;
                            }
                            
                            HorizontalBox {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                
                                password-field := LineEdit {
                                    horizontal-stretch: 1;
                                    text <=> root.password;
                                    placeholder-text: "Введите пароль";
                                    input-type: InputType.password;
                                    enabled: !root.is-loading;
                                    font-size: 15px;
                                }
                                
                                // Password visibility toggle icon
                                Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    
                                    Path {
                                        width: 20px;
                                        height: 20px;
                                        fill: #808080;
                                        viewbox-width: 24;
                                        viewbox-height: 24;
                                        commands: "M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z";
                                    }
                                }
                            }
                        }
                    }
                    
                    // Error Message
                    if root.error-message != "": Rectangle {
                        height: 48px;
                        background: #3D1F1F;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #FF4444;
                        
                        HorizontalBox {
                            padding: 12px;
                            spacing: 10px;
                            
                            // Error icon
                            Rectangle {
                                width: 20px;
                                height: 20px;
                                
                                Path {
                                    width: 20px;
                                    height: 20px;
                                    fill: #FF4444;
                                    viewbox-width: 24;
                                    viewbox-height: 24;
                                    commands: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z";
                                }
                            }
                            
                            MaterialText {
                                text: root.error-message;
                                color: #FF6B6B;
                                font-size: 14px;
                                wrap: word-wrap;
                                vertical-alignment: center;
                            }
                        }
                    }
                    
                    // Login Button
                    Rectangle {
                        height: 52px;
                        background: root.is-loading || root.username == "" || root.password == "" ? 
                            MaterialPalette.surface-container-high : 
                            (login-btn-touch.pressed ? #5E35B1 : 
                             login-btn-touch.has-hover ? #7E57C2 : MaterialPalette.primary);
                        border-radius: 26px;
                        drop-shadow-blur: login-btn-touch.has-hover ? 12px : 6px;
                        drop-shadow-color: #00000060;
                        drop-shadow-offset-y: login-btn-touch.pressed ? 1px : 3px;
                        
                        animate background, drop-shadow-blur, drop-shadow-offset-y {
                            duration: 150ms;
                            easing: ease-in-out;
                        }
                        
                        login-btn-touch := TouchArea {
                            enabled: !root.is-loading && root.username != "" && root.password != "";
                            mouse-cursor: self.enabled ? pointer : default;
                            
                            clicked => {
                                root.login-clicked();
                            }
                        }
                        
                        HorizontalBox {
                            alignment: center;
                            spacing: 8px;
                            
                            if root.is-loading: Rectangle {
                                width: 20px;
                                height: 20px;
                                
                                // Loading spinner
                                Path {
                                    width: 20px;
                                    height: 20px;
                                    fill: MaterialPalette.on-primary;
                                    viewbox-width: 24;
                                    viewbox-height: 24;
                                    commands: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z";
                                }
                            }
                            
                            MaterialText {
                                text: root.is-loading ? "Загрузка..." : "Войти";
                                color: root.is-loading || root.username == "" || root.password == "" ? 
                                    MaterialPalette.on-surface-variant : 
                                    MaterialPalette.on-primary;
                                font-size: 16px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    
                    // Loading Indicator
                    if root.is-loading: Rectangle {
                        height: 2px;
                        background: MaterialPalette.primary;
                        
                        // Simple loading animation
                        animate background {
                            duration: 1s;
                            iteration-count: -1;
                        }
                    }
                }
                
                // Footer Section
                VerticalBox {
                    spacing: 5px;
                    
                    MaterialText {
                        text: "© 2025 Автопарк автобусов";
                        font-size: 12px;
                        color: #808080;
                        horizontal-alignment: center;
                    }
                    
                    MaterialText {
                        text: "Все права защищены";
                        font-size: 12px;
                        color: #808080;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}
