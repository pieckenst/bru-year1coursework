import { VerticalBox, HorizontalBox, LineEdit, ComboBox, Button, ScrollView, CheckBox, ListView } from "std-widgets.slint";
import { MaterialText, TextField, FilledButton, TonalButton, OutlineButton } from "../material-1.0/material.slint";
import { MaterialPalette } from "../material-1.0/ui/styling/material_palette.slint";

// Route stop item for multi-select
export struct RouteStopItem {
    name: string,
    selected: bool,
}

// Route Schedule Add/Edit Dialog
export component RouteScheduleDialog inherits Dialog {
    in-out property <string> dialog-title: "Добавить расписание";
    
    // Time fields
    in-out property <string> departure-time: "";
    in-out property <string> arrival-time: "";
    
    // Numeric fields
    in-out property <string> price: "";
    in-out property <string> available-seats: "";
    
    // Route stops multi-select
    in-out property <[RouteStopItem]> available-stops: [];
    in-out property <int> selected-stops-count: 0;
    
    // Checkboxes
    in-out property <bool> is-active: true;
    in-out property <bool> is-recurring: true;
    
    // Additional fields
    in-out property <string> stop-duration-minutes: "5";
    in-out property <string> notes: "";
    
    // Estimated data display (read-only)
    in-out property <[string]> estimated-stop-times: [];
    in-out property <[string]> stop-distances: [];
    
    // Validation and error handling
    in-out property <string> error-message: "";
    in-out property <string> validation-error: "";
    in-out property <bool> is-edit-mode: false;
    
    callback save-clicked();
    callback cancel-clicked();
    callback stop-selection-changed(int, bool);
    
    preferred-width: 720px;
    preferred-height: 820px;
    min-height: 820px;
    max-height: 900px;
    
    Rectangle {
        background: MaterialPalette.surface;
        
        VerticalBox {
            padding: 24px;
            spacing: 16px;
            
            // Dialog title
            MaterialText {
                text: root.dialog-title;
                font-size: 24px;
                font-weight: 600;
                color: MaterialPalette.on-surface;
            }
            
            // Scrollable content with all fields
            ScrollView {
                height: 640px;
                viewport-height: 1000px;
                
                VerticalBox {
                    spacing: 24px;
                    
                    // SECTION 1: Time Information
                    VerticalBox {
                        spacing: 12px;
                        
                        MaterialText {
                            text: "Время отправления и прибытия";
                            font-size: 18px;
                            font-weight: 600;
                            color: MaterialPalette.on-surface;
                        }
                        
                        HorizontalBox {
                            spacing: 12px;
                            
                            VerticalBox {
                                horizontal-stretch: 1;
                                spacing: 8px;
                                
                                MaterialText {
                                    text: "Время отправления *";
                                    font-size: 14px;
                                    color: MaterialPalette.on-surface;
                                }
                                TextField {
                                    text <=> root.departure-time;
                                    placeholder-text: "HH:MM (напр. 08:30)";
                                }
                            }
                            
                            VerticalBox {
                                horizontal-stretch: 1;
                                spacing: 8px;
                                
                                MaterialText {
                                    text: "Время прибытия *";
                                    font-size: 14px;
                                    color: MaterialPalette.on-surface;
                                }
                                TextField {
                                    text <=> root.arrival-time;
                                    placeholder-text: "HH:MM (напр. 10:45)";
                                }
                            }
                        }
                        
                        MaterialText {
                            text: "Формат времени: ЧЧ:ММ (24-часовой формат)";
                            font-size: 12px;
                            color: MaterialPalette.on-surface-variant;
                        }
                    }
                    
                    // SECTION 2: Pricing and Capacity
                    VerticalBox {
                        spacing: 12px;
                        
                        MaterialText {
                            text: "Цена и вместимость";
                            font-size: 18px;
                            font-weight: 600;
                            color: MaterialPalette.on-surface;
                        }
                        
                        HorizontalBox {
                            spacing: 12px;
                            
                            VerticalBox {
                                horizontal-stretch: 1;
                                spacing: 8px;
                                
                                MaterialText {
                                    text: "Цена билета (₽) *";
                                    font-size: 14px;
                                    color: MaterialPalette.on-surface;
                                }
                                TextField {
                                    text <=> root.price;
                                    placeholder-text: "2.50";
                                }
                            }
                            
                            VerticalBox {
                                horizontal-stretch: 1;
                                spacing: 8px;
                                
                                MaterialText {
                                    text: "Доступных мест *";
                                    font-size: 14px;
                                    color: MaterialPalette.on-surface;
                                }
                                TextField {
                                    text <=> root.available-seats;
                                    placeholder-text: "42";
                                }
                            }
                            
                            VerticalBox {
                                horizontal-stretch: 1;
                                spacing: 8px;
                                
                                MaterialText {
                                    text: "Длительность остановки (мин)";
                                    font-size: 14px;
                                    color: MaterialPalette.on-surface;
                                }
                                TextField {
                                    text <=> root.stop-duration-minutes;
                                    placeholder-text: "5";
                                }
                            }
                        }
                    }
                    
                    // SECTION 3: Route Stops Multi-Select
                    VerticalBox {
                        spacing: 12px;
                        
                        HorizontalBox {
                            spacing: 8px;
                            alignment: start;
                            
                            MaterialText {
                                text: "Остановки маршрута";
                                font-size: 18px;
                                font-weight: 600;
                                color: MaterialPalette.on-surface;
                                vertical-alignment: center;
                            }
                            
                            MaterialText {
                                text: "(" + selected-stops-count + " выбрано)";
                                font-size: 14px;
                                color: MaterialPalette.on-surface-variant;
                                vertical-alignment: center;
                            }
                        }
                        
                        // Validation message for minimum stops
                        if selected-stops-count < 2: Rectangle {
                            height: 36px;
                            background: #fff3e0;
                            border-radius: 4px;
                            
                            HorizontalBox {
                                padding: 8px;
                                
                                MaterialText {
                                    text: "⚠ Необходимо выбрать минимум 2 остановки";
                                    color: #e65100;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        
                        // Multi-select list
                        Rectangle {
                            height: 240px;
                            background: MaterialPalette.surface-container-low;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: MaterialPalette.outline-variant;
                            
                            ScrollView {
                                VerticalBox {
                                    spacing: 0px;
                                    
                                    if available-stops.length == 0: VerticalBox {
                                        padding: 40px;
                                        alignment: center;
                                        
                                        MaterialText {
                                            text: "Нет доступных остановок";
                                            color: MaterialPalette.on-surface-variant;
                                            font-size: 14px;
                                            horizontal-alignment: center;
                                        }
                                    }
                                    
                                    for stop[index] in available-stops: Rectangle {
                                        height: 44px;
                                        background: stop.selected ? MaterialPalette.secondary-container : 
                                                   (mod(index, 2) == 0 ? MaterialPalette.surface-container : MaterialPalette.surface);
                                        
                                        HorizontalBox {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            spacing: 12px;
                                            
                                            CheckBox {
                                                checked: stop.selected;
                                                
                                                toggled => {
                                                    stop-selection-changed(index, self.checked);
                                                }
                                            }
                                            
                                            MaterialText {
                                                text: stop.name;
                                                color: MaterialPalette.on-surface;
                                                font-size: 14px;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        
                        MaterialText {
                            text: "Выберите остановки, которые будут включены в это расписание";
                            font-size: 12px;
                            color: MaterialPalette.on-surface-variant;
                        }
                    }
                    
                    // SECTION 4: Status and Options
                    VerticalBox {
                        spacing: 12px;
                        
                        MaterialText {
                            text: "Статус и параметры";
                            font-size: 18px;
                            font-weight: 600;
                            color: MaterialPalette.on-surface;
                        }
                        
                        HorizontalBox {
                            spacing: 24px;
                            
                            HorizontalBox {
                                spacing: 8px;
                                
                                CheckBox {
                                    checked <=> root.is-active;
                                }
                                
                                MaterialText {
                                    text: "Активно";
                                    font-size: 14px;
                                    color: MaterialPalette.on-surface;
                                    vertical-alignment: center;
                                }
                            }
                            
                            HorizontalBox {
                                spacing: 8px;
                                
                                CheckBox {
                                    checked <=> root.is-recurring;
                                }
                                
                                MaterialText {
                                    text: "Повторяющееся";
                                    font-size: 14px;
                                    color: MaterialPalette.on-surface;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        
                        MaterialText {
                            text: "Активно: расписание доступно для бронирования\nПовторяющееся: расписание действует на регулярной основе";
                            font-size: 12px;
                            color: MaterialPalette.on-surface-variant;
                            wrap: word-wrap;
                        }
                    }
                    
                    // SECTION 5: Estimated Stop Times (Read-only display)
                    if estimated-stop-times.length > 0: VerticalBox {
                        spacing: 12px;
                        
                        MaterialText {
                            text: "Расчетное время остановок";
                            font-size: 18px;
                            font-weight: 600;
                            color: MaterialPalette.on-surface;
                        }
                        
                        Rectangle {
                            height: 160px;
                            background: MaterialPalette.surface-container-lowest;
                            border-radius: 4px;
                            
                            ScrollView {
                                VerticalBox {
                                    padding: 12px;
                                    spacing: 8px;
                                    
                                    for time[index] in estimated-stop-times: HorizontalBox {
                                        spacing: 12px;
                                        
                                        MaterialText {
                                            text: "Остановка " + (index + 1) + ":";
                                            font-size: 13px;
                                            color: MaterialPalette.on-surface-variant;
                                            min-width: 100px;
                                        }
                                        
                                        MaterialText {
                                            text: time;
                                            font-size: 13px;
                                            color: MaterialPalette.on-surface;
                                            font-weight: 600;
                                        }
                                        
                                        if index < stop-distances.length: MaterialText {
                                            text: "(" + stop-distances[index] + " км)";
                                            font-size: 13px;
                                            color: MaterialPalette.on-surface-variant;
                                        }
                                    }
                                }
                            }
                        }
                        
                        MaterialText {
                            text: "Время рассчитывается автоматически на основе времени отправления и прибытия";
                            font-size: 12px;
                            color: MaterialPalette.on-surface-variant;
                        }
                    }
                    
                    // SECTION 6: Notes
                    VerticalBox {
                        spacing: 8px;
                        
                        MaterialText {
                            text: "Примечания";
                            font-size: 14px;
                            color: MaterialPalette.on-surface;
                        }
                        
                        TextField {
                            text <=> root.notes;
                            placeholder-text: "Дополнительная информация о расписании";
                        }
                    }
                }
            }
            
            // Validation error message
            if validation-error != "": Rectangle {
                height: 40px;
                background: #ffebee;
                border-radius: 4px;
                
                HorizontalBox {
                    padding: 10px;
                    
                    MaterialText {
                        text: validation-error;
                        color: #c62828;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
            
            // Error message
            if error-message != "": Rectangle {
                height: 40px;
                background: #ffebee;
                border-radius: 4px;
                
                HorizontalBox {
                    padding: 10px;
                    
                    MaterialText {
                        text: error-message;
                        color: MaterialPalette.error;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                }
            }
            
            // Action buttons
            HorizontalBox {
                spacing: 12px;
                alignment: end;
                
                OutlineButton {
                    text: "Отмена";
                    clicked => {
                        root.cancel-clicked();
                    }
                }
                
                FilledButton {
                    text: root.is-edit-mode ? "Сохранить" : "Добавить";
                    enabled: root.departure-time != "" && 
                            root.arrival-time != "" && 
                            root.price != "" && 
                            root.available-seats != "" &&
                            root.selected-stops-count >= 2;
                    
                    clicked => {
                        root.save-clicked();
                    }
                }
            }
        }
    }
}

// Delete Confirmation Dialog
export component DeleteScheduleConfirmDialog inherits Dialog {
    in-out property <string> schedule-description: "";
    
    callback confirm-delete();
    callback cancel-delete();
    
    preferred-width: 480px;
    preferred-height: 220px;
    
    Rectangle {
        background: MaterialPalette.surface;
        
        VerticalBox {
            padding: 24px;
            spacing: 20px;
            
            MaterialText {
                text: "Подтверждение удаления";
                font-size: 20px;
                font-weight: 600;
                color: MaterialPalette.on-surface;
            }
            
            MaterialText {
                text: "Вы уверены, что хотите удалить расписание:\n" + root.schedule-description + "?";
                font-size: 16px;
                color: MaterialPalette.on-surface;
                wrap: word-wrap;
            }
            
            Rectangle {
                vertical-stretch: 1;
            }
            
            HorizontalBox {
                spacing: 12px;
                alignment: end;
                
                OutlineButton {
                    text: "Отмена";
                    clicked => {
                        root.cancel-delete();
                    }
                }
                
                FilledButton {
                    text: "Удалить";
                    clicked => {
                        root.confirm-delete();
                    }
                }
            }
        }
    }
}
