import { Button, VerticalBox, HorizontalBox, LineEdit } from "std-widgets.slint";
import { MaterialWindow, FilledCard, TextField, FilledButton, TonalButton, HorizontalDivider, MaterialText, ScrollView } from "../material-1.0/material.slint";
import { MaterialPalette } from "../material-1.0/ui/styling/material_palette.slint";
import { AppNavigation } from "navigation.slint";
import { EmployeeDialog, DeleteConfirmDialog, JobData, DepartmentData } from "employee_dialogs.slint";
import { EmployeeDetailView, DocumentData, TrainingData, EmergencyContactData, VacationData } from "employee_detail.slint";
import { BusManagementView, BusData } from "bus_management.slint";
import { RouteManagementView, RouteData } from "route_management.slint";
import { RouteSchedulesManagement, ScheduleData, RouteOption } from "route_schedules.slint";
export { AuthWindow } from "auth_window.slint";

// Employee data structure
export struct EmployeeData {
    id: int,
    surname: string,
    name: string,
    department: string,
    position: string,
}

// Main Application Window
export component AppWindow inherits Window {
    title: "Система управления автопарком";
    width: 1600px;
    height: 980px;
    default-font-family: "Arial";
    
    in-out property <string> current-user: "";
    in-out property <[EmployeeData]> employees;
    in-out property <int> current-nav-group: 1;
    in-out property <int> current-nav-index: 0;
    in-out property <bool> drawer-open: true;
    
    // Employee dialog state - Basic
    in-out property <bool> show-employee-dialog: false;
    in-out property <string> dialog-mode: "add";
    in-out property <string> dialog-title: "";
    in-out property <int> employee-id: 0;
    in-out property <string> employee-surname: "";
    in-out property <string> employee-name: "";
    in-out property <string> employee-patronym: "";
    in-out property <int> selected-job-id: -1;
    in-out property <int> selected-department-id: -1;
    in-out property <[string]> job-names: [];
    in-out property <[string]> department-names: [];
    // Personal info
    in-out property <string> passport-series: "";
    in-out property <string> passport-number: "";
    in-out property <string> date-of-birth: "";
    in-out property <string> email: "";
    in-out property <string> address: "";
    in-out property <string> personal-phone: "";
    in-out property <string> snils: "";
    // Driver info
    in-out property <string> driver-license-number: "";
    in-out property <string> driver-license-category: "";
    in-out property <string> driver-license-issue-date: "";
    in-out property <string> driver-license-expiry: "";
    // Medical info
    in-out property <string> medical-cert-number: "";
    in-out property <string> medical-cert-issue-date: "";
    in-out property <string> medical-cert-expiry: "";
    in-out property <string> employee-error: "";
    
    // Delete dialog state
    in-out property <bool> show-delete-dialog: false;
    in-out property <int> delete-employee-id: 0;
    in-out property <string> delete-employee-name: "";
    
    // Employee detail view state
    in-out property <bool> show-employee-detail: false;
    in-out property <int> detail-employee-id: 0;
    in-out property <string> detail-employee-name: "";
    in-out property <[DocumentData]> employee-documents: [];
    in-out property <[TrainingData]> employee-training: [];
    in-out property <[EmergencyContactData]> employee-contacts: [];
    in-out property <[VacationData]> employee-vacations: [];
    
    callback logout-clicked();
    callback refresh-employees();
    callback add-employee-clicked();
    callback edit-employee-clicked(int);
    callback delete-employee-clicked(int);
    callback view-employee-detail-clicked(int);
    callback navigation-changed(int, int);
    callback save-employee();
    callback confirm-delete();
    
    // Employee detail callbacks
    callback load-employee-documents(int);
    callback add-document-clicked();
    callback edit-document-clicked(int);
    callback delete-document-clicked(int);
    callback add-training-clicked();
    callback edit-training-clicked(int);
    callback delete-training-clicked(int);
    callback add-contact-clicked();
    callback edit-contact-clicked(int);
    callback delete-contact-clicked(int);
    callback add-vacation-clicked();
    callback approve-vacation-clicked(int);
    callback reject-vacation-clicked(int);
    callback delete-vacation-clicked(int);
    
    // Bus management state
    in-out property <[BusData]> buses: [];
    in-out property <bool> buses-loading: false;
    in-out property <string> buses-error: "";
    in-out property <bool> buses-has-error: false;
    
    // Bus management callbacks
    callback load-buses();
    callback search-buses(string);
    callback add-bus(string);
    callback edit-bus(int, string);
    callback delete-bus(int);
    
    // Route management state
    in-out property <[RouteData]> routes: [];
    in-out property <bool> routes-loading: false;
    in-out property <string> routes-error: "";
    in-out property <bool> routes-has-error: false;
    in-out property <[string]> route-bus-options: [];
    in-out property <[string]> route-driver-options: [];
    
    // Route management callbacks
    callback load-routes();
    callback search-routes(string);
    callback add-route(string, string, string, int, int);
    callback edit-route(int, string, string, string, int, int);
    callback delete-route(int);
    callback load-route-dropdown-data();
    
    // Route schedule management state
    in-out property <[ScheduleData]> schedules: [];
    in-out property <[RouteOption]> schedule-routes: [];
    in-out property <[string]> schedule-route-names: [];
    in-out property <[string]> route-stops-list: [];
    in-out property <int> selected-schedule-route-index: -1;
    in-out property <string> selected-schedule-date: "";
    in-out property <bool> schedules-loading: false;
    in-out property <string> schedules-error: "";
    in-out property <bool> schedules-has-error: false;
    
    // Pagination properties
    in-out property <int> current-page: 0;
    in-out property <int> page-size: 100;
    in-out property <int> total-schedules: 0;
    
    // Route schedule management callbacks
    callback load-schedules();
    callback load-routes-for-selector();
    callback add-schedule();
    callback edit-schedule(int);
    callback delete-schedule(int);
    callback schedule-route-selected(int);
    callback schedule-date-changed(string);
    callback next-page();
    callback previous-page();
    
    AppNavigation {
        current-user: root.current-user;
        current-group: root.current-nav-group;
        current-index: root.current-nav-index;
        drawer-open: root.drawer-open;
        
        navigation-selected(group, index) => {
            root.current-nav-group = group;
            root.current-nav-index = index;
            root.navigation-changed(group, index);
        }
        
        logout => {
            root.logout-clicked();
        }
        
        // Content based on navigation - Employees view (Group 1, Index 0)
        if root.current-nav-group == 1 && root.current-nav-index == 0: VerticalBox {
                
                VerticalBox {
                    padding: 10px;
                    
                    // Toolbar
                    HorizontalBox {
                        padding: 16px;
                        spacing: 12px;
                        alignment: start;
                        
                        FilledButton {
                            text: "Добавить сотрудника";
                            clicked => {
                                root.add-employee-clicked();
                            }
                        }
                        
                        TonalButton {
                            text: "Обновить";
                            clicked => {
                                root.refresh-employees();
                            }
                        }
                        
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                    
                    HorizontalDivider {}
                    
                    // Employee list with Material Design
                    ScrollView {
                        VerticalBox {
                            spacing: 0px;
                            
                            // Table header
                            Rectangle {
                                height: 48px;
                                background: MaterialPalette.surface_container_high;
                                
                                HorizontalBox {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 12px;
                                    
                                    MaterialText {
                                        width: 50px;
                                        text: "ID";
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                    MaterialText {
                                        width: 150px;
                                        text: "Фамилия";
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                    MaterialText {
                                        width: 150px;
                                        text: "Имя";
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                    MaterialText {
                                        width: 180px;
                                        text: "Отдел";
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                    MaterialText {
                                        horizontal-stretch: 1;
                                        text: "Должность";
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            
                            // Employee rows with Material Design styling
                            for employee[index] in root.employees: Rectangle {
                                height: 56px;
                                background: touch.has-hover ? MaterialPalette.surface_container_highest : (mod(index, 2) == 0 ? MaterialPalette.surface_container : MaterialPalette.surface_container_low);
                                
                                touch := TouchArea {}
                                
                                HorizontalBox {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 12px;
                                    
                                    MaterialText {
                                        width: 50px;
                                        text: employee.id;
                                        vertical-alignment: center;
                                    }
                                    MaterialText {
                                        width: 150px;
                                        text: employee.surname;
                                        vertical-alignment: center;
                                    }
                                    MaterialText {
                                        width: 150px;
                                        text: employee.name;
                                        vertical-alignment: center;
                                    }
                                    MaterialText {
                                        width: 180px;
                                        text: employee.department;
                                        vertical-alignment: center;
                                    }
                                    MaterialText {
                                        horizontal-stretch: 1;
                                        text: employee.position;
                                        vertical-alignment: center;
                                    }
                                    
                                    // Action buttons
                                    HorizontalBox {
                                        spacing: 8px;
                                        alignment: center;
                                        
                                        // View Details button
                                        Rectangle {
                                            width: 40px;
                                            height: 40px;
                                            border-radius: 20px;
                                            background: view-touch.has-hover ? MaterialPalette.primary_container : transparent;
                                            
                                            view-touch := TouchArea {
                                                clicked => {
                                                    root.view-employee-detail-clicked(employee.id);
                                                }
                                            }
                                            
                                            MaterialText {
                                                text: "👁️";
                                                font-size: 18px;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                            }
                                        }
                                        
                                        // Edit button
                                        Rectangle {
                                            width: 40px;
                                            height: 40px;
                                            border-radius: 20px;
                                            background: edit-touch.has-hover ? MaterialPalette.secondary_container : transparent;
                                            
                                            edit-touch := TouchArea {
                                                clicked => {
                                                    root.edit-employee-clicked(employee.id);
                                                }
                                            }
                                            
                                            MaterialText {
                                                text: "✏️";
                                                font-size: 18px;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                            }
                                        }
                                        
                                        // Delete button
                                        Rectangle {
                                            width: 40px;
                                            height: 40px;
                                            border-radius: 20px;
                                            background: delete-touch.has-hover ? MaterialPalette.error_container : transparent;
                                            
                                            delete-touch := TouchArea {
                                                clicked => {
                                                    root.delete-employee-clicked(employee.id);
                                                }
                                            }
                                            
                                            MaterialText {
                                                text: "🗑️";
                                                font-size: 18px;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        
        // Placeholder for other navigation routes
        if root.current-nav-group == 0 && root.current-nav-index == 0: VerticalBox {
            padding: 40px;
            MaterialText {
                text: "Панель управления";
                font-size: 24px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Rectangle { vertical-stretch: 1; }
            MaterialText {
                text: "В разработке";
                horizontal-alignment: center;
            }
        }
        
        if root.current-nav-group == 1 && root.current-nav-index != 0: VerticalBox {
            padding: 40px;
            MaterialText {
                text: "Раздел персонала";
                font-size: 24px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Rectangle { vertical-stretch: 1; }
            MaterialText {
                text: "В разработке";
                horizontal-alignment: center;
            }
        }
        
        // Bus Management View (Group 2, Index 0)
        if root.current-nav-group == 2 && root.current-nav-index == 0: BusManagementView {
            buses: root.buses;
            is-loading: root.buses-loading;
            error-message: root.buses-error;
            has-error: root.buses-has-error;
            
            load-buses => {
                root.load-buses();
            }
            
            search-buses(text) => {
                root.search-buses(text);
            }
            
            add-bus(model) => {
                root.add-bus(model);
            }
            
            edit-bus(bus-id, model) => {
                root.edit-bus(bus-id, model);
            }
            
            delete-bus(bus-id) => {
                root.delete-bus(bus-id);
            }
        }
        
        // Route Management View (Group 2, Index 1)
        if root.current-nav-group == 2 && root.current-nav-index == 1: RouteManagementView {
            routes: root.routes;
            is-loading: root.routes-loading;
            error-message: root.routes-error;
            has-error: root.routes-has-error;
            bus-options: root.route-bus-options;
            driver-options: root.route-driver-options;
            
            load-routes => {
                root.load-routes();
            }
            
            search-routes(text) => {
                root.search-routes(text);
            }
            
            add-route(start, end, time, bus-idx, driver-idx) => {
                root.add-route(start, end, time, bus-idx, driver-idx);
            }
            
            edit-route(route-id, start, end, time, bus-idx, driver-idx) => {
                root.edit-route(route-id, start, end, time, bus-idx, driver-idx);
            }
            
            delete-route(route-id) => {
                root.delete-route(route-id);
            }
            
            load-dropdown-data => {
                root.load-route-dropdown-data();
            }
        }
        
        // Route Schedules Management View (Group 2, Index 2)
        if root.current-nav-group == 2 && root.current-nav-index == 2: RouteSchedulesManagement {
            schedules: root.schedules;
            routes: root.schedule-routes;
            route_names: root.schedule-route-names;
            route_stops_list: root.route-stops-list;
            selected_route_index: root.selected-schedule-route-index;
            selected_date: root.selected-schedule-date;
            is_loading: root.schedules-loading;
            error_message: root.schedules-error;
            has_error: root.schedules-has-error;
            
            load_schedules => {
                root.load-schedules();
            }
            
            load_routes => {
                root.load-routes-for-selector();
            }
            
            add_schedule => {
                root.add-schedule();
            }
            
            edit_schedule(schedule-id) => {
                root.edit-schedule(schedule-id);
            }
            
            delete_schedule(schedule-id) => {
                root.delete-schedule(schedule-id);
            }
            
            route_selected(route-idx) => {
                root.schedule-route-selected(route-idx);
            }
            
            date_changed(date-str) => {
                root.schedule-date-changed(date-str);
            }
        }
        
        // Placeholder for other transport routes
        if root.current-nav-group == 2 && root.current-nav-index > 2: VerticalBox {
            padding: 40px;
            MaterialText {
                text: "Раздел транспорта";
                font-size: 24px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Rectangle { vertical-stretch: 1; }
            MaterialText {
                text: "В разработке";
                horizontal-alignment: center;
            }
        }
        
        if root.current-nav-group >= 3: VerticalBox {
            padding: 40px;
            MaterialText {
                text: "Раздел в разработке";
                font-size: 24px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Rectangle { vertical-stretch: 1; }
            MaterialText {
                text: "Скоро будет реализовано";
                horizontal-alignment: center;
            }
        }
    }
    
    // Employee Add/Edit Dialog
    if root.show-employee-dialog: EmployeeDialog {
        dialog-title: root.dialog-title;
        // Basic
        surname <=> root.employee-surname;
        name <=> root.employee-name;
        patronym <=> root.employee-patronym;
        selected-job-id <=> root.selected-job-id;
        selected-department-id <=> root.selected-department-id;
        job-names <=> root.job-names;
        department-names <=> root.department-names;
        // Personal
        passport-series <=> root.passport-series;
        passport-number <=> root.passport-number;
        date-of-birth <=> root.date-of-birth;
        email <=> root.email;
        address <=> root.address;
        personal-phone <=> root.personal-phone;
        snils <=> root.snils;
        // Driver
        driver-license-number <=> root.driver-license-number;
        driver-license-category <=> root.driver-license-category;
        driver-license-issue-date <=> root.driver-license-issue-date;
        driver-license-expiry <=> root.driver-license-expiry;
        // Medical
        medical-cert-number <=> root.medical-cert-number;
        medical-cert-issue-date <=> root.medical-cert-issue-date;
        medical-cert-expiry <=> root.medical-cert-expiry;
        error-message <=> root.employee-error;
        is-edit-mode: root.dialog-mode == "edit";
        
        save-clicked => {
            root.save-employee();
        }
        
        cancel-clicked => {
            root.show-employee-dialog = false;
            root.employee-error = "";
        }
    }
    
    // Delete Confirmation Dialog
    if root.show-delete-dialog: DeleteConfirmDialog {
        employee-name: root.delete-employee-name;
        
        confirm-delete => {
            root.confirm-delete();
        }
        
        cancel-delete => {
            root.show-delete-dialog = false;
        }
    }
    
    // Employee Detail View Overlay
    if root.show-employee-detail: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000088;
        
        Rectangle {
            width: 800px;
            height: parent.height;
            x: parent.width - self.width;
            background: MaterialPalette.surface;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000044;
            
            EmployeeDetailView {
                employee-id: root.detail-employee-id;
                employee-name: root.detail-employee-name;
                documents: root.employee-documents;
                training: root.employee-training;
                contacts: root.employee-contacts;
                vacations: root.employee-vacations;
                
                close-clicked => {
                    root.show-employee-detail = false;
                }
                
                add-document-clicked => {
                    root.add-document-clicked();
                }
                
                edit-document-clicked(doc-id) => {
                    root.edit-document-clicked(doc-id);
                }
                
                delete-document-clicked(doc-id) => {
                    root.delete-document-clicked(doc-id);
                }
                
                add-training-clicked => {
                    root.add-training-clicked();
                }
                
                edit-training-clicked(train-id) => {
                    root.edit-training-clicked(train-id);
                }
                
                delete-training-clicked(train-id) => {
                    root.delete-training-clicked(train-id);
                }
                
                add-contact-clicked => {
                    root.add-contact-clicked();
                }
                
                edit-contact-clicked(contact-id) => {
                    root.edit-contact-clicked(contact-id);
                }
                
                delete-contact-clicked(contact-id) => {
                    root.delete-contact-clicked(contact-id);
                }
                
                add-vacation-clicked => {
                    root.add-vacation-clicked();
                }
                
                approve-vacation-clicked(req-id) => {
                    root.approve-vacation-clicked(req-id);
                }
                
                reject-vacation-clicked(req-id) => {
                    root.reject-vacation-clicked(req-id);
                }
                
                delete-vacation-clicked(req-id) => {
                    root.delete-vacation-clicked(req-id);
                }
            }
        }
    }
}
