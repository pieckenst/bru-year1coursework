import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { MaterialText, FilledButton, TonalButton } from "../material-1.0/material.slint";
import { MaterialPalette } from "../material-1.0/ui/styling/material_palette.slint";
import { LineEdit } from "std-widgets.slint";

// Bus data structure
export struct BusData {
    bus-id: int,
    model: string,
    route-count: int,
}

// Bus Management View - CRUD operations for bus fleet
export component BusManagementView inherits Rectangle {
    in-out property <[BusData]> buses: [];
    in-out property <BusData> selected-bus: { bus-id: -1, model: "", route-count: 0 };
    in-out property <string> search-text: "";
    in-out property <bool> is-loading: false;
    in-out property <string> error-message: "";
    in-out property <bool> has-error: false;
    
    // Dialog states
    in-out property <bool> show-add-dialog: false;
    in-out property <bool> show-edit-dialog: false;
    in-out property <bool> show-delete-dialog: false;
    
    // Dialog form fields
    in-out property <string> dialog-model: "";
    
    // Callbacks
    callback load-buses();
    callback search-buses(string);
    callback add-bus(string);
    callback edit-bus(int, string);
    callback delete-bus(int);
    callback close-clicked();
    
    background: MaterialPalette.surface;
    
    VerticalBox {
        padding: 0px;
        
        // Header
        Rectangle {
            height: 64px;
            background: MaterialPalette.surface-container-highest;
            
            HorizontalBox {
                padding: 16px;
                spacing: 16px;
                
                MaterialText {
                    text: "Управление автобусами";
                    font-size: 20px;
                    font-weight: 600;
                    color: MaterialPalette.on-surface;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: close-touch.has-hover ? MaterialPalette.surface-container : transparent;
                    
                    close-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => { root.close-clicked(); }
                    }
                    
                    Path {
                        width: 20px;
                        height: 20px;
                        x: 10px;
                        y: 10px;
                        fill: MaterialPalette.on-surface;
                        commands: "M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41z";
                    }
                }
            }
        }
        
        // Content
        VerticalBox {
            padding: 16px;
            spacing: 16px;
            
            // Search and Actions Bar
            HorizontalBox {
                spacing: 16px;
                
                Rectangle {
                    horizontal-stretch: 1;
                    height: 48px;
                    background: MaterialPalette.surface-container;
                    border-radius: 24px;
                    
                    HorizontalBox {
                        padding: 16px;
                        spacing: 12px;
                        
                        Path {
                            width: 20px;
                            height: 20px;
                            fill: MaterialPalette.on-surface-variant;
                            commands: "M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z";
                        }
                        
                        LineEdit {
                            horizontal-stretch: 1;
                            text: root.search-text;
                            placeholder-text: "Поиск автобусов...";
                            font-size: 14px;
                            
                            edited(text) => {
                                root.search-text = text;
                                root.search-buses(text);
                            }
                        }
                    }
                }
                
                FilledButton {
                    text: "Добавить";
                    min-width: 120px;
                    height: 48px;
                    
                    clicked => {
                        root.dialog-model = "";
                        root.show-add-dialog = true;
                    }
                }
            }
            
            // Error Message
            if root.has-error: Rectangle {
                height: 48px;
                background: MaterialPalette.error-container;
                border-radius: 8px;
                
                HorizontalBox {
                    padding: 16px;
                    spacing: 12px;
                    
                    Path {
                        width: 20px;
                        height: 20px;
                        fill: MaterialPalette.on-error-container;
                        commands: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z";
                    }
                    
                    MaterialText {
                        text: root.error-message;
                        color: MaterialPalette.on-error-container;
                        font-size: 14px;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
            
            // Loading Indicator
            if root.is-loading: Rectangle {
                height: 80px;
                
                MaterialText {
                    text: "Загрузка...";
                    font-size: 16px;
                    color: MaterialPalette.on-surface-variant;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            
            // Bus List
            if !root.is-loading: ScrollView {
                VerticalBox {
                    spacing: 8px;
                    
                    // Empty State
                    if root.buses.length == 0: Rectangle {
                        height: 120px;
                        background: MaterialPalette.surface-container;
                        border-radius: 12px;
                        
                        VerticalBox {
                            padding: 24px;
                            spacing: 8px;
                            
                            Path {
                                width: 32px;
                                height: 32px;
                                x: parent.width / 2 - 16px;
                                fill: MaterialPalette.on-surface-variant;
                                commands: "M4 16c0 .88.39 1.67 1 2.22V20c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h8v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1.78c.61-.55 1-1.34 1-2.22V6c0-3.5-3.58-4-8-4s-8 .5-8 4v10zm3.5 1c-.83 0-1.5-.67-1.5-1.5S6.67 14 7.5 14s1.5.67 1.5 1.5S8.33 17 7.5 17zm9 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm1.5-6H6V6.85c.52-.86 2.24-1.85 6-1.85s5.48.99 6 1.85V11z";
                            }
                            
                            MaterialText {
                                text: "Нет автобусов";
                                font-size: 16px;
                                font-weight: 500;
                                color: MaterialPalette.on-surface-variant;
                                horizontal-alignment: center;
                            }
                            
                            MaterialText {
                                text: "Добавьте первый автобус, чтобы начать";
                                font-size: 14px;
                                color: MaterialPalette.on-surface-variant;
                                horizontal-alignment: center;
                            }
                        }
                    }
                    
                    // Bus Cards
                    for bus[idx] in root.buses: Rectangle {
                        height: 80px;
                        background: root.selected-bus.bus-id == bus.bus-id ? MaterialPalette.secondary-container : MaterialPalette.surface-container;
                        border-radius: 12px;
                        
                        bus-touch := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.selected-bus = bus;
                            }
                        }
                        
                        HorizontalBox {
                            padding: 16px;
                            spacing: 16px;
                            
                            // Bus Icon
                            Rectangle {
                                width: 48px;
                                height: 48px;
                                border-radius: 24px;
                                background: MaterialPalette.primary;
                                
                                Path {
                                    width: 24px;
                                    height: 24px;
                                    x: 12px;
                                    y: 12px;
                                    fill: MaterialPalette.on-primary;
                                    commands: "M4 16c0 .88.39 1.67 1 2.22V20c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h8v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1.78c.61-.55 1-1.34 1-2.22V6c0-3.5-3.58-4-8-4s-8 .5-8 4v10zm3.5 1c-.83 0-1.5-.67-1.5-1.5S6.67 14 7.5 14s1.5.67 1.5 1.5S8.33 17 7.5 17zm9 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm1.5-6H6V6.85c.52-.86 2.24-1.85 6-1.85s5.48.99 6 1.85V11z";
                                }
                            }
                            
                            // Bus Info
                            VerticalBox {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                
                                MaterialText {
                                    text: bus.model;
                                    font-size: 16px;
                                    font-weight: 600;
                                    color: root.selected-bus.bus-id == bus.bus-id ? MaterialPalette.on-secondary-container : MaterialPalette.on-surface;
                                }
                                
                                MaterialText {
                                    text: "ID: " + bus.bus-id + " • Маршрутов: " + bus.route-count;
                                    font-size: 14px;
                                    color: root.selected-bus.bus-id == bus.bus-id ? MaterialPalette.on-secondary-container : MaterialPalette.on-surface-variant;
                                }
                            }
                            
                            // Action Buttons
                            HorizontalBox {
                                spacing: 8px;
                                
                                TonalButton {
                                    text: "Изменить";
                                    min-width: 80px;
                                    height: 36px;
                                    
                                    clicked => {
                                        root.selected-bus = bus;
                                        root.dialog-model = bus.model;
                                        root.show-edit-dialog = true;
                                    }
                                }
                                
                                TonalButton {
                                    text: "Удалить";
                                    min-width: 80px;
                                    height: 36px;
                                    
                                    clicked => {
                                        root.selected-bus = bus;
                                        root.show-delete-dialog = true;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    
    // Add Bus Dialog
    if root.show-add-dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000080;
        
        Rectangle {
            width: 400px;
            height: 200px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: MaterialPalette.surface;
            border-radius: 12px;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000040;
            
            VerticalBox {
                padding: 24px;
                spacing: 16px;
                
                MaterialText {
                    text: "Добавить автобус";
                    font-size: 18px;
                    font-weight: 600;
                    color: MaterialPalette.on-surface;
                }
                
                LineEdit {
                    text: root.dialog-model;
                    placeholder-text: "Модель автобуса";
                    
                    edited(text) => {
                        root.dialog-model = text;
                    }
                }
                
                HorizontalBox {
                    spacing: 12px;
                    
                    Rectangle { horizontal-stretch: 1; }
                    
                    TonalButton {
                        text: "Отмена";
                        
                        clicked => {
                            root.show-add-dialog = false;
                            root.dialog-model = "";
                        }
                    }
                    
                    FilledButton {
                        text: "Добавить";
                        
                        clicked => {
                            if root.dialog-model != "" {
                                root.add-bus(root.dialog-model);
                                root.show-add-dialog = false;
                                root.dialog-model = "";
                            }
                        }
                    }
                }
            }
        }
    }
    
    // Edit Bus Dialog
    if root.show-edit-dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000080;
        
        Rectangle {
            width: 400px;
            height: 200px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: MaterialPalette.surface;
            border-radius: 12px;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000040;
            
            VerticalBox {
                padding: 24px;
                spacing: 16px;
                
                MaterialText {
                    text: "Изменить автобус";
                    font-size: 18px;
                    font-weight: 600;
                    color: MaterialPalette.on-surface;
                }
                
                LineEdit {
                    text: root.dialog-model;
                    placeholder-text: "Модель автобуса";
                    
                    edited(text) => {
                        root.dialog-model = text;
                    }
                }
                
                HorizontalBox {
                    spacing: 12px;
                    
                    Rectangle { horizontal-stretch: 1; }
                    
                    TonalButton {
                        text: "Отмена";
                        
                        clicked => {
                            root.show-edit-dialog = false;
                            root.dialog-model = "";
                        }
                    }
                    
                    FilledButton {
                        text: "Сохранить";
                        
                        clicked => {
                            if root.dialog-model != "" {
                                root.edit-bus(root.selected-bus.bus-id, root.dialog-model);
                                root.show-edit-dialog = false;
                                root.dialog-model = "";
                            }
                        }
                    }
                }
            }
        }
    }
    
    // Delete Bus Dialog
    if root.show-delete-dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000080;
        
        Rectangle {
            width: 400px;
            height: 200px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: MaterialPalette.surface;
            border-radius: 12px;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000040;
            
            VerticalBox {
                padding: 24px;
                spacing: 16px;
                
                MaterialText {
                    text: "Удалить автобус";
                    font-size: 18px;
                    font-weight: 600;
                    color: MaterialPalette.on-surface;
                }
                
                MaterialText {
                    text: "Вы уверены, что хотите удалить автобус \"" + root.selected-bus.model + "\"?";
                    font-size: 14px;
                    color: MaterialPalette.on-surface-variant;
                    wrap: word-wrap;
                }
                
                HorizontalBox {
                    spacing: 12px;
                    
                    Rectangle { horizontal-stretch: 1; }
                    
                    TonalButton {
                        text: "Отмена";
                        
                        clicked => {
                            root.show-delete-dialog = false;
                        }
                    }
                    
                    FilledButton {
                        text: "Удалить";
                        
                        clicked => {
                            root.delete-bus(root.selected-bus.bus-id);
                            root.show-delete-dialog = false;
                        }
                    }
                }
            }
        }
    }
}
